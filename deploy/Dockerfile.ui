# Console image: the app/ build baked into a Caddy server.
# Build context is the repo root. bun installs, Node runs vite.
FROM node:24-alpine AS build
COPY --from=oven/bun:1.4.2-alpine /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /repo
COPY package.json bun.lock ./
COPY web/package.json web/
COPY packages packages
COPY app app
RUN bun install --frozen-lockfile --filter agentpit-app
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Optional: absent means the "Continue with Google" button does not render.
ARG VITE_WORKOS_CLIENT_ID
ENV VITE_WORKOS_CLIENT_ID=$VITE_WORKOS_CLIENT_ID
# The gate lives HERE and not in the compose file's interpolation, because
# compose interpolates the WHOLE file on EVERY command: a `${VAR:?}` on a
# caddy build arg makes `docker compose restart anvil` fail too. Vite inlines
# the value at build time, and without it the console calls localhost.
RUN : "${VITE_API_BASE_URL:?set it in .env}" && bun run --cwd app build

FROM caddy:2
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/app/dist /srv
