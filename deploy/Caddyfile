# agentpit.dev over TLS. Caddy obtains and renews the certificates itself; the
# only requirements are that the hostnames resolve here and that :80 stays
# published, because that is where the ACME HTTP challenge lands.
#
# TLS is not optional for this domain. `.dev` is on the HSTS preload list baked
# into Chrome, Firefox, Safari and Edge, so every browser rewrites
# http://agentpit.dev to https:// before it sends a single packet. Without a
# certificate the site does not merely lose the padlock -- it does not load.

# --- UI: static SPA ------------------------------------------------------------
agentpit.dev {
	encode gzip

	# Vite puts a content hash in every file name under /assets, so a name never
	# comes back with different bytes and a year is safe.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is index.html -- directly or through the SPA fallback --
	# and index.html names the current bundle. With no Cache-Control a browser
	# caches it heuristically, for 10% of its age: the 2026-09-21 deploy replaced
	# a month-old file, and returning visitors kept the old app for days. no-cache
	# still lets them keep it, but asks first; the ETag makes that a cheap 304.
	@app not path /assets/*
	header @app Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

www.agentpit.dev {
	redir https://agentpit.dev{uri} permanent
}

# --- API: same-machine reverse proxy; uvicorn itself is never published -------
api.agentpit.dev {
	reverse_proxy api:8000
}

# --- Transitional: the bare IP redirects instead of serving -------------------
# These two existed so that anything configured before the domain -- a cached
# bundle, an old bookmark, a bot -- kept working. They no longer SERVE, because
# what they were serving was the whole API over plaintext http on a public IP:
# every `X-API-Key` and every bearer token sent to them travelled in the clear,
# and an API key does not expire.
#
# A redirect rather than a deletion, deliberately. Deleting breaks an unknown
# caller silently; a 308 moves it to TLS and leaves a line in the access log
# naming who still needs moving. `redir` alone would answer GETs and turn a POST
# into a GET, so 308 is the code -- it is the one that preserves the method and
# the body.
#
# Remove both blocks once the logs have been quiet for a while. Note that a
# container recreate resets those logs, so "quiet" means quiet since the last
# deploy, not quiet forever.
http://23.88.62.130 {
	redir https://agentpit.dev{uri} 308
}

:8000 {
	redir https://api.agentpit.dev{uri} 308
}
