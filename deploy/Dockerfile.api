# API image: uvicorn serving agentpit.api.main:app.
# Build context is the repo root (see docker-compose.prod.yml).
FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agentpit/ agentpit/
# The one-off backfills are written to be run against production
# (`docker exec agentpit-api-1 python -m scripts.<name> --dry-run`), so they
# have to be in the image — the API itself never imports them. Only the
# backfills: the rest of scripts/ is local tooling, and db_reset.sh has no
# business being one typo away from a production shell.
COPY scripts/backfill_*.py scripts/

# deployments/local.json is bind-mounted at runtime (Settings default path is
# deployments/local.json relative to the workdir) — see compose.
# `--proxy-headers` is what makes `request.client.host` the real caller
# rather than Caddy, and the per-IP rate limit on /auth/code is meaningless
# without it -- every request would land in one bucket. `*` is safe ONLY
# because this service publishes no ports: Caddy on the compose network is
# the only thing that can reach it, so nobody outside can forge the header.
# Publish a port here and this line becomes a hole.
CMD ["uvicorn", "agentpit.api.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*", "--timeout-graceful-shutdown", "5"]
