# Server-side .env — copy to the repo root on the instance and fill in.
# Read by BOTH `docker compose --env-file .env` and scripts/deploy_exchange.sh.
# NEVER commit the filled file.

# --- chain operator (paper chain: anvil's standard dev account #0) ----------
PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ADMIN=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Container-network RPC — used by the api service and by chain-init.
RPC_URL=http://anvil:8545

# --- secrets: generate each with `openssl rand -hex 32` ---------------------
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
AGENTPIT_ADMIN_TOKEN=CHANGE_ME

# --- public URLs -------------------------------------------------------------
# VITE_API_BASE_URL is baked into the UI bundle at BUILD time and shown verbatim
# in the landing page's setup snippets. Changing it means rebuilding `caddy`,
# not just restarting it -- a restart alone leaves the shipped bundle calling
# the old address, and since the site is served over https the browser blocks
# that as mixed content: the page loads and not a single market appears.
VITE_API_BASE_URL=https://api.agentpit.dev
# Every origin the browser may load the UI from. A missing entry is not a
# server error -- the request succeeds and the browser discards the response,
# so it looks like the API is down when it is answering fine.
AGENTPIT_CORS_ORIGINS=["https://app.agentpit.dev","https://agentpit.dev","https://www.agentpit.dev","http://23.88.62.130"]

# --- Google sign-in (optional) ---------------------------------------------
# One OAuth client id, used twice: the API checks every Google ID token's
# audience against GOOGLE_CLIENT_ID, and the UI bundle is BUILT with
# VITE_GOOGLE_CLIENT_ID. They must be the same value — a UI built with a
# different id produces tokens the API will reject.
#
# Create it at console.cloud.google.com: OAuth client → Web application, with
# https://agentpit.dev and http://localhost:5173 as authorised JavaScript
# origins and no redirect URI. Publish the consent screen: while it is in
# Testing, only listed test users can sign in. A client id is public; there is
# no client secret in this flow.
#
# Leave both unset and the feature is absent: no button, and POST /auth/google
# answers 503.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- WorkOS / AuthKit --------------------------------------------------------
# Reaches the api container through `env_file: ../.env`, exactly like
# GOOGLE_CLIENT_ID above -- there is no entry for it under the api service.
#
# WORKOS_API_KEY is the only secret of the three (sk_...). Leaving it blank does
# NOT just switch mailed-code sign-in off: `build_workos_client` returns None,
# and PRIVATE KEY EXPORT is gone with it. POST /me/private-key/code and
# POST /me/private-key both answer 503, so no existing account can take its
# wallet key out. Export used to be a password check that worked with no WorkOS
# configured at all; on this deployment it does not. Fill this in BEFORE
# deploying, or accept that export is off.
WORKOS_API_KEY=
# Public, and needed twice like the Google id: the API pins every access
# token's issuer to api.workos.com/user_management/<WORKOS_CLIENT_ID>, and the
# UI bundle is BUILT with VITE_WORKOS_CLIENT_ID. Two different values means the
# UI sends people to one tenant and the API only trusts the other.
WORKOS_CLIENT_ID=
VITE_WORKOS_CLIENT_ID=
# The hosted AuthKit surface: scheme required, no trailing slash. It is the
# issuer of the OAuth tokens MCP clients send; /mcp is off without an https
# value, WORKOS_API_KEY and WORKOS_CLIENT_ID.
WORKOS_AUTHKIT_DOMAIN=
# The MCP endpoint's public URL: the token audience and the only Host /mcp
# answers. Must match the WorkOS resource indicator.
AGENTPIT_MCP_URL=https://api.agentpit.dev/mcp
#
# Do NOT add WORKOS_ISSUER or WORKOS_JWKS_URL here. Both are derived from
# WORKOS_CLIENT_ID (auth/authkit_tokens.py). The value that looks right --
# the AuthKit domain, which <domain>/.well-known/openid-configuration
# advertises as "issuer" -- is the wrong one: real access tokens carry
# api.workos.com/user_management/<client_id>, so setting it rejects every
# sign-in with no configuration error to point at.

# --- product config (mirror of the dev setup) --------------------------------
# Paper balance restored by the profile's top-up button, raw (6 decimals).
AGENTPIT_PAPER_BALANCE_TARGET_RAW=100000000000
AGENTPIT_TOPUP_COOLDOWN_SECONDS=86400
SYNC=true
SYNC_MAX_MARKETS=1000
SYNC_LIQUIDITY_MIN=5000
# Sibling outcomes pulled in per event for a market that already qualified, capped at this many (busiest by 24h volume first).
SYNC_EVENT_MAX_OUTCOMES=12
# Categories carried by neither the sync, the catalogue, nor the book mirror.
# Sports (which is where `resolve_category` files esports too) is excluded
# because the UI has no rendering for it: a match resolves in hours and its
# book empties the moment it does, so the grid fills with rows that read as
# broken. It was 68.6% of the standing catalogue, so this is also the largest
# single reduction in gas and anvil growth. `[]` carries everything again.
AGENTPIT_EXCLUDED_CATEGORIES=["Sports"]
LIQUIDITY_ENGINE=true
# Total book depth per side that the slow sweep converges to (ships inert at
# 8 — identical to the pre-deep-book behaviour). Raise to 50 to turn the deep
# book on deliberately; live order count can exceed the cap between sweeps on
# a fast-moving market.
AGENTPIT_MIRROR_BOOK_DEPTH=8
# Levels per side re-quoted on EVERY upstream book update.
AGENTPIT_MIRROR_HOT_DEPTH=8
# How often each market's deep levels are refreshed.
AGENTPIT_MIRROR_COLD_INTERVAL_SECONDS=1800
# Inventory is minted in blocks of this size (micro-apUSD) above what a market
# needs, so a market converges after one split instead of paying a transaction
# per upstream depth record. Measured before this landed: 64 splits/min, ~92k
# transactions a day, which drained the house account's gas in ~82 minutes.
# 1e14 micro = 100M apUSD, well above the largest requirement seen (39M).
# Collateral is free on the simulated chain; lower this on a chain where it
# is not. 0 restores the old exact top-ups.
AGENTPIT_MIRROR_INVENTORY_SEED_MICRO=100000000000000
# The house signs its own split transactions, so it spends gas continuously and
# its one-time signup grant is not a lifetime supply. Without this loop the
# account drained in ~82 minutes and every split after that failed silently.
# Refills are gas only -- never collateral, never re-approvals.
AGENTPIT_LIQUIDITY_GAS_FLOOR_WEI=5000000000000000000
AGENTPIT_LIQUIDITY_GAS_TARGET_WEI=100000000000000000000
AGENTPIT_LIQUIDITY_GAS_CHECK_INTERVAL_SECONDS=300
# Keep true while the chain is a disposable anvil that can be wiped under a
# surviving database — a zero native balance then means "the chain forgot this
# account" and login re-runs onboarding to repair it. Set FALSE before pointing
# at a real chain: there a zero balance just means the account spent its gas,
# and re-granting on login is a treasury faucet anyone can drain on repeat.
AGENTPIT_SIMULATED_CHAIN=true
# Pinned-series sync re-quotes a whole book every 1s — heavy CPU. Keep off.
PIN_SYNC_ENABLED=false
RESOLUTION_MIRROR_ENABLED=true
RESOLUTION_MIRROR_INTERVAL_SECONDS=300
AUTO_REDEEM_ENABLED=true
# Leaderboard valuation pass -- reads every traded account's chain balance,
# so it is opt-in like the other timers above rather than on by default.
AGENTPIT_LEADERBOARD_ENABLED=true
