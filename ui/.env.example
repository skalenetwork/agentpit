VITE_API_BASE_URL=http://localhost:8000

# The Google OAuth client id (Web application). Leave it out and the
# "Continue with Google" button does not render.
VITE_GOOGLE_CLIENT_ID=

# WorkOS, for the Google redirect. Missing, the Google block does not render,
# because vite inlines it at build time and `present()` in lib/workosAuth.ts
# reads undefined. It must be the same client id the API has as
# WORKOS_CLIENT_ID. The redirect is <page origin>/auth/callback, so register
# http://localhost:5173/auth/callback in the WorkOS dashboard for local dev.
VITE_WORKOS_CLIENT_ID=
