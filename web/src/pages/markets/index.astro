---
import MarketsPage from "../../components/markets/MarketsPage.astro";
import { boardQuery, marketBoard } from "../../lib/api";

export const prerender = false;

const board = await marketBoard({ tab: "trending", ...boardQuery(Astro.url) });
if (!board) Astro.cache.set(false);
if (board === null) return new Response(null, { status: 404 });
if (board === undefined) Astro.response.status = 503;
---

<MarketsPage board={board} path="/markets" />
