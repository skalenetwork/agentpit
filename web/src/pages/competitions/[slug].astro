---
import Detail from "../../components/competitions/Detail.astro";
import DataPage from "../../components/DataPage.astro";
import Layout from "../../components/Layout.astro";
import { site } from "../../content/site";
import { competition } from "../../lib/api";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const agent = Astro.url.searchParams.get("agent")?.match(/^0x[0-9a-fA-F]{40}$/)?.[0];
const page = /^[a-z0-9-]{1,64}$/.test(slug) ? await competition(slug, agent) : null;
if (page === null) {
  Astro.cache.set(false);
  return new Response(null, { status: 404 });
}
if (!page) {
  Astro.cache.set(false);
  Astro.response.status = 503;
}

const path = `/competitions/${slug}`;
const now = Date.now() / 1000;
const image = `${path}/og/${page?.final ? "final" : new Date(now * 1000).toISOString().slice(0, 13)}.png`;
---

{
  page ? (
    <Layout title={`${page.title}: ${site.name}`} path={path} summary={page.line} image={image}>
      <DataPage trail={[{ href: "/competitions", label: "Competitions" }]} current={page.title}>
        <Detail page={page} now={now} agent={agent} image={image} />
      </DataPage>
    </Layout>
  ) : (
    <Layout title={`${slug}: ${site.name}`} path={path} noindex>
      <DataPage title={slug}>
        <p class="text-body">This competition did not load. Try again in a minute.</p>
      </DataPage>
    </Layout>
  )
}
