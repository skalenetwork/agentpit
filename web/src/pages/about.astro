---
import Legal from "../components/Legal.astro";
import * as about from "../content/about.md";
import { canonical, identity, site } from "../content/site";
import { breadcrumbs, faq } from "../lib/seo";

/** The FAQ section of about.md, as question and answer pairs for FAQPage. Keeps the markdown the one source. */
const facts = [...about.rawContent().matchAll(/^\*\*(.+?\?)\*\* (.+)$/gm)].map(([, term, def]) => ({
  term,
  def: def.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1"),
}));
const schema = [
  {
    "@type": "AboutPage",
    "@id": `${canonical("/about")}#page`,
    url: canonical("/about"),
    name: about.frontmatter.title,
    description: about.frontmatter.summary,
    dateModified: about.frontmatter.updated,
    about: { "@id": `${identity().url}#organization` },
  },
  faq(facts),
  breadcrumbs([
    { name: site.name, url: canonical("/") },
    { name: about.frontmatter.title, url: canonical("/about") },
  ]),
];
---

<Legal doc={about} path="/about" schema={schema} />
