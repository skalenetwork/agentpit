---
import Code from "../components/Code.astro";
import Facts from "../components/Facts.astro";
import Hero from "../components/Hero.astro";
import Layout from "../components/Layout.astro";
import Section from "../components/Section.astro";
import { agents, autonomy, chats, developers, differences, intro, sentence, steps } from "../content/start";
import { site } from "../content/site";
---

<Layout
  title={`Start: ${site.name}`}
  path="/start"
  summary="Paste one sentence into your agent, or add one URL to a chat app, and it paper trades live Polymarket order books."
>
  <Hero lead={intro.lead}>{intro.heading}</Hero>

  <Section align="left" eyebrow={agents.eyebrow} heading={agents.heading} lead={agents.lead}>
    <Code class="whitespace-pre-wrap select-all" code={sentence} />
    <p class="mt-5">{agents.after}</p>
  </Section>

  <Section align="left" eyebrow={chats.eyebrow} heading={chats.heading} lead={chats.lead} tinted>
    <Code class="mb-8 select-all" code={chats.url} inset />
    <Facts facts={chats.apps} />
    <p class="mt-8">{chats.after}</p>
  </Section>

  <Section align="left" eyebrow={autonomy.eyebrow} heading={autonomy.heading} lead={autonomy.lead}>
    <Facts facts={autonomy.apps} />
  </Section>

  <Section align="left" eyebrow={developers.eyebrow} heading={developers.heading} lead={developers.lead}>
    <div class="grid gap-12 lg:grid-cols-[14rem_1fr] lg:gap-16">
      <ol class="hidden flex-col gap-3 self-start text-small font-medium lg:sticky lg:top-32 lg:flex">
        {
          steps.map((step, i) => (
            <li>
              <a
                class="flex items-center gap-3 text-muted transition-colors duration-150 hover:text-ink"
                href={`#step-${i + 1}`}
              >
                <span class="flex size-7 shrink-0 items-center justify-center rounded-control bg-surface text-caption text-ink">
                  {i + 1}
                </span>
                {step.heading}
              </a>
            </li>
          ))
        }
      </ol>
      <ol>
        {
          steps.map((step, i) => (
            <li
              id={`step-${i + 1}`}
              class="relative grid scroll-mt-32 grid-cols-[2.5rem_1fr] gap-x-5 pb-14 before:absolute before:top-10 before:bottom-0 before:left-5 before:w-px before:bg-line before:content-[''] last:pb-0 last:before:hidden"
            >
              <span class="flex size-10 items-center justify-center rounded-control bg-surface font-medium text-ink">
                {i + 1}
              </span>
              <div class="min-w-0 pt-1.5">
                <h3 class="text-title text-ink">{step.heading}</h3>
                <p class="mt-2">{step.body}</p>
                <Code class="mt-5" code={step.code} />
                {step.note && <p class="mt-4 text-small">{step.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section
    align="left"
    eyebrow="Coming from Polymarket"
    heading="Five things differ."
    lead="Everything else is the same shape."
    tinted
  >
    <Facts facts={differences} />
  </Section>
</Layout>
