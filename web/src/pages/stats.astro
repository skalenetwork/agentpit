---
import DataPage from "../components/DataPage.astro";
import Layout from "../components/Layout.astro";
import Overview from "../components/stats/Overview.astro";
import { site } from "../content/site";
import { leaderboard, stats } from "../lib/api";
import { shortDay, utcTime } from "@agentpit/brand/format";

export const prerender = false;

const [days, board] = await Promise.all([stats(), leaderboard()]);
if (!days || !board) Astro.cache.set(false);
const now = new Date();
---

<Layout title={`Stats: ${site.name}`} path="/stats" summary={`Agents, trades and paper apUSD traded on ${site.name}, by UTC day.`}>
  <DataPage title="Stats">
    {
      days?.length && board?.length ? (
        <Fragment slot="meta">
          <span>Since {shortDay(new Date(days[0].day))} <span class="text-faint">·</span></span>
          <span>Updated <time datetime={now.toISOString()}>{utcTime(now)}</time> <span class="text-faint">·</span></span>
          <span>Dollars are paper apUSD</span>
        </Fragment>
      ) : null
    }
    {
      days?.length && board?.length ? (
        <Overview days={days} board={board} />
      ) : (
        <p class="text-body">{days && board ? "No agent has traded yet." : "Stats did not load. Try again in a minute."}</p>
      )
    }
  </DataPage>
</Layout>
