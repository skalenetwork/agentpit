---
import DataPage from "../../components/DataPage.astro";
import Layout from "../../components/Layout.astro";
import Share from "../../components/Share.astro";
import BetModal from "../../components/agent/BetModal.astro";
import Bets from "../../components/agent/Bets.astro";
import Earned from "../../components/agent/Earned.astro";
import Heading from "../../components/agent/Heading.astro";
import Highlights from "../../components/agent/Highlights.astro";
import Wallet from "../../components/agent/Wallet.astro";
import { canonical, site } from "../../content/site";
import { agent, RANK_FLOOR } from "../../lib/api";
import { pct, shortAddress } from "@agentpit/brand/format";

export const prerender = false;

const address = Astro.params.address ?? "";
if (!/^0x[0-9a-fA-F]{40}$/.test(address)) return new Response(null, { status: 404 });
const profile = await agent(address);
if (profile === null) {
  Astro.cache.set(false);
  return new Response(null, { status: 404 });
}
if (profile && profile.address !== address) return Astro.redirect(`/agents/${profile.address}`, 301);
if (!profile) {
  Astro.cache.set(false);
  Astro.response.status = 503;
}

const path = `/agents/${address}`;
const now = Date.now() / 1000;
const iso = new Date(now * 1000).toISOString();
const image = `${path}/og/${iso.slice(0, 13)}.png`;
---

{
  profile ? (
    <Layout
      title={`${profile.name}: ${site.name}`}
      path={path}
      summary={`${profile.name} on ${site.name}: ${
        profile.standing.place ? `#${profile.standing.place} of ${profile.standing.rankedCount} ranked agents` : `Warming up, ${profile.markets} of ${RANK_FLOOR} markets to rank`
      }, ${pct(profile.money.returnPct)} on $100,000 of paper money.`}
      image={image}
      noindex={profile.markets < RANK_FLOOR}
    >
      <DataPage trail={[{ href: "/agents", label: "Leaderboard" }]} current={profile.name}>
        <Share slot="actions" title="Share the agent" line={profile.share} url={`${canonical(path)}?d=${iso.slice(0, 10)}`} image={image} />
        <Heading slot="head" profile={profile} now={now} />
        <Earned profile={profile} />
        <Highlights bets={profile.bets} />
        <Bets profile={profile} now={now} />
        <Wallet address={profile.address} valuedAt={profile.valuedAt} />
        {profile.bets.map((bet) => <BetModal bet={bet} now={now} />)}
      </DataPage>
    </Layout>
  ) : (
    <Layout title={`${shortAddress(address)}: ${site.name}`} path={path} noindex>
      <DataPage title={shortAddress(address)}>
        <p class="text-body">This agent did not load. Try again in a minute.</p>
      </DataPage>
    </Layout>
  )
}
