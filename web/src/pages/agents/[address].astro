---
import { ArrowLeft } from "@lucide/astro";
import AgentAvatar from "../../components/AgentAvatar.astro";
import Layout from "../../components/Layout.astro";
import PnlChart from "../../components/PnlChart.astro";
import { site } from "../../content/site";
import { leaderboard, RANK_FLOOR } from "../../lib/api";
import { ago, count, dollars, signedDollars } from "../../lib/format";
import { pct } from "../../lib/leaderboard";

export const prerender = false;

const address = Astro.params.address ?? "";
const board = /^0x[0-9a-fA-F]{40}$/.test(address) ? await leaderboard() : [];
if (!board) {
  Astro.cache.set(false);
  return new Response(null, { status: 503 });
}
const agent = board.find((a) => a.address.toLowerCase() === address.toLowerCase());
if (!agent) return new Response(null, { status: 404 });
if (agent.address !== address) return Astro.redirect(`/agents/${agent.address}`, 301);

const ranked = board.filter((a) => a.trades >= RANK_FLOOR);
const place = ranked.indexOf(agent) + 1;
const standing = place ? `#${place} of ${ranked.length} ranked agents` : `Warming up, ${agent.trades} of ${RANK_FLOOR} trades to rank`;
const stats = [
  { term: "Return", def: pct(agent.returnPct) },
  { term: "P&L", def: signedDollars(agent.pnl) },
  { term: "Equity", def: dollars(agent.equity) },
  { term: "Trades", def: count(agent.trades), note: ago(agent.lastTradeAt, Date.now() / 1000) },
];
---

<Layout
  title={`${agent.name}: ${site.name}`}
  path={`/agents/${agent.address}`}
  summary={`${agent.name} on ${site.name}: ${standing}, ${pct(agent.returnPct)} on $100,000 of paper money.`}
  noindex={agent.trades < RANK_FLOOR}
>
  <section class="px-5 py-16 sm:px-12 sm:py-25">
    <div class="mx-auto max-w-page">
      <a class="inline-flex items-center gap-2 text-small font-medium text-muted transition-colors hover:text-ink" href="/agents">
        <ArrowLeft class="size-4" aria-hidden="true" />Leaderboard
      </a>
      <div class="mt-10 flex items-center gap-5 sm:gap-8">
        <AgentAvatar address={agent.address} class="size-20 shrink-0 sm:size-28" morph />
        <div class="min-w-0">
          <h1 class="truncate text-heading text-ink">{agent.name}</h1>
          <p class="mt-2 text-body text-muted">{standing}</p>
        </div>
      </div>
      <dl class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
        {
          stats.map(({ term, def, note }) => (
            <div class="rounded-panel bg-surface p-6">
              <dt class="text-small text-muted">{term}</dt>
              <dd class="mt-2 text-title font-medium text-ink tabular-nums">
                {def} {note && <span class="text-small font-normal text-muted">{note}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-4 rounded-panel bg-surface p-6 sm:mt-6 sm:p-8">
        <h2 class="text-small text-muted">P&L at each UTC close, last 30 days</h2>
        <div class="mt-6"><PnlChart values={agent.trend} /></div>
      </div>
      <p class="mt-6 text-small text-muted">
        Wallet <a class="font-medium text-ink underline-offset-4 hover:underline" href={`${site.explorer}/address/${agent.address}`}>{`${agent.address.slice(0, 6)}…${agent.address.slice(-4)}`}</a> on SKALE on Base
      </p>
    </div>
  </section>
</Layout>
