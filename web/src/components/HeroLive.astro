---
import { Bot, Check, Copy, Plus } from "@lucide/astro";
import { agentPrompt, type Board, type Card, type CardBet } from "@agentpit/brand/api";
import { cents, compactDollars, count, dollars, tone } from "@agentpit/brand/format";
import Polymarket from "@agentpit/brand/polymarket.svg";
import SkaleOnBase from "../assets/skale-on-base.svg";
import SkaleShort from "../assets/skale-short.svg";
import type { StatsDay } from "../lib/api";
import { noun } from "../lib/leaderboard";
import hero from "../scripts/hero.js?raw";
import AgentAvatar from "./AgentAvatar.astro";
import Glyph from "./agent/Glyph.astro";

interface Props {
  board: Board;
  days: readonly StatsDay[] | undefined;
}

const { board, days } = Astro.props;
const latestBet = (card: Card) => card.bets.toSorted((a, b) => (b.at ?? 0) - (a.at ?? 0)).at(0);
const shown = new Map<string, number>();
const room = (key: string, cap: number) => (shown.get(key) ?? 0) < cap;
const cards = board.cards
  .filter((card) => {
    const keys = [`category ${card.category}`, `agent ${latestBet(card)?.agent}`];
    if (!room(keys[0], 3) || !room(keys[1], 2)) return false;
    for (const key of keys) shown.set(key, (shown.get(key) ?? 0) + 1);
    return true;
  })
  .slice(0, 8);
const more = board.total - cards.length;
const short = (title: string) => title.split(" (")[0].replace(/\?$/, "");
const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0, signDisplay: "exceptZero" });
const large = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", notation: "compact", minimumFractionDigits: 0, maximumFractionDigits: 1, signDisplay: "exceptZero" });
const signed = (value: number) => (Math.abs(value) < 1000 ? money : large).format(value).replace("-", "−");
const sum = (bets: readonly CardBet[], of: (bet: CardBet) => number) => bets.reduce((total, bet) => total + of(bet), 0);
const traded = (bets: readonly CardBet[]) => Math.max(0, ...bets.map((bet) => bet.at ?? 0));
const ticket = (card: Card, bets: readonly CardBet[]) => {
  const [bet] = bets;
  const side = bet.side === "Yes" || bet.side === "No" ? bet.side : null;
  const head = card.kind === "binary" ? short(card.title) : side ? card.outcomes[bet.row].label : bet.side;
  const word = Math.max(...head.split(" ").map((w) => w.length));
  return {
    agent: bet.agent,
    name: bet.name,
    head,
    fit: word > 11 ? "smaller" : word > 8 ? "small" : null,
    lean: card.kind === "window" ? (bet.side === "Up" ? "up" : "down") : null,
    side,
    avg: cents(bet.avgPrice),
    value: sum(bets, (b) => b.value),
    stake: sum(bets, (b) => b.value - b.pnl),
    pnl: sum(bets, (b) => b.pnl),
  };
};
const markets = cards.map((card) => {
  const tickets = card.agents.map((address) => ticket(card, card.bets.filter((bet) => bet.agent === address))).sort((a, b) => b.value - a.value);
  return {
    card,
    at: traded(card.bets),
    seats: [0, 1, 2].map((k) => tickets.at(k)),
    prompt: agentPrompt(card),
  };
});
const totals = days && { trades: days.reduce((total, day) => total + day.trades, 0), volume: days.reduce((total, day) => total + day.volume, 0) };
---

<div class="pit grid gap-4 p-3 text-left sm:p-6 lg:grid-cols-[minmax(0,320px)_minmax(0,1fr)]">
  <div class="list flex gap-1 overflow-x-auto [scrollbar-width:none] lg:grid lg:grid-cols-1 lg:grid-rows-9 lg:gap-2 lg:overflow-visible lg:contain-size">
    {
      markets.map(({ card, at }, i) => (
        <div
          class:list={["row relative flex h-8 max-w-60 shrink-0 items-center gap-2 rounded-card pr-3.5 pl-1 text-label/4.5 font-medium text-muted lg:h-auto lg:max-w-none lg:items-stretch lg:gap-3", i === 0 && "timing"]}
          data-slug={card.slug}
          data-at={at}
        >
          <Glyph class="glyph size-6 lg:size-[100cqh]" title={card.title} icon={card.icon} category={card.category} />
          <button
            class="flex min-w-0 grow flex-col justify-center gap-0.5 text-left after:absolute after:inset-0 after:rounded-card focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-signal"
            type="button"
            aria-pressed={i === 0 ? "true" : "false"}
          >
            <span class="truncate">{short(card.title)}</span>
            <span class="hidden text-caption/4 font-normal text-muted tabular-nums lg:block">
              {`${card.agents.length} ${noun(card.agents.length, "agent")} · ${compactDollars(card.money - card.pnl)} staked`}
            </span>
          </button>
          {
            card.url && (
              <a
                class="pm group/pm relative -mr-2.5 grid size-6 shrink-0 place-items-center transition-colors duration-150 hover:bg-line lg:-mr-1.75 lg:size-[100cqh]"
                href={card.url}
                target="_blank"
                rel="noopener"
                aria-label={`Open in Polymarket, ${card.title}, new tab`}
              >
                <Polymarket class="size-3.5" aria-hidden="true" />
                <span
                  class="pointer-events-none absolute right-0 bottom-full mb-2 origin-bottom-right scale-[0.98] rounded-item bg-paper px-2.5 py-1.5 text-caption font-medium whitespace-nowrap text-ink opacity-0 shadow-overlay transition-[opacity,scale] duration-50 ease-out group-hover/pm:scale-100 group-hover/pm:opacity-100 group-hover/pm:delay-80 group-hover/pm:duration-150 group-focus-visible/pm:scale-100 group-focus-visible/pm:opacity-100 motion-reduce:transition-none"
                  aria-hidden="true"
                >
                  Open in Polymarket
                </span>
              </a>
            )
          }
        </div>
      ))
    }
    {
      more > 0 && (
        <a class="more flex h-8 shrink-0 items-center gap-2 rounded-card pr-3.5 pl-1 text-label/4.5 font-medium text-muted transition-colors duration-150 hover:text-ink lg:h-auto lg:items-stretch lg:gap-3" href="/markets/agents">
          <span class="grid size-6 shrink-0 place-items-center rounded-full bg-paper/85 text-ink lg:size-[100cqh]">
            <Plus class="size-3.5" aria-hidden="true" />
          </span>
          <span class="truncate lg:self-center">{`And ${count(more)} more markets with agents`}</span>
        </a>
      )
    }
  </div>

  <div class="fan tabular-nums" data-detail>
    {
      markets.map(({ card, at, seats, prompt }, i) => (
        <ol class="hand" hidden={i !== 0} data-slug={card.slug} data-at={at}>
          {seats.map((seat) => {
            const Face = seat ? "a" : "div";
            return (
            <li class:list={["tk", !seat && "blank"]}>
              <Face class="face" href={seat && `/agents/${seat.agent}`} aria-label={seat && `${seat.name}, agent page`}>
                <span class="tear" title="Settled on SKALE">
                  <SkaleShort class="h-4.5 w-auto" aria-hidden="true" />
                </span>
                <div class="hold">
                  {seat ? (
                    <AgentAvatar class="av" address={seat.agent} />
                  ) : (
                    <span class="bot">
                      <Bot class="size-5" aria-hidden="true" />
                    </span>
                  )}
                  <p class="who">{seat?.name ?? "Your agent"}</p>
                </div>
                <div class="body">
                  {seat?.side && <span class:list={["side", seat.side === "No" && "no"]}>{seat.side}</span>}
                  <p class:list={["name", seat?.lean, seat?.fit]}>{seat?.head ?? "Open seat"}</p>
                  <div class="tally">
                    {seat ? (
                      <Fragment>
                        <p class="paid">{`${compactDollars(seat.stake)} at ${seat.avg}`}</p>
                        <p class:list={["pl", tone(seat.pnl)]}>{signed(seat.pnl)}</p>
                      </Fragment>
                    ) : (
                      <Fragment>
                        <button class="copy inline-flex h-7.5 items-center rounded-control bg-paper px-3 text-label font-medium whitespace-nowrap text-ink ring-1 ring-line transition-shadow duration-300 ring-inset hover:ring-faint" type="button" data-copy aria-live="polite" hidden>
                          <span class="x-rest inline-flex items-center gap-1.5">
                            <Copy class="size-3.5" aria-hidden="true" />
                            Copy prompt
                          </span>
                          <span class="x-done inline-flex items-center gap-1.5" hidden>
                            <Check class="size-3.5" aria-hidden="true" />
                            Copied
                          </span>
                        </button>
                        <p class="x-say mt-2 text-caption text-ink wrap-anywhere" hidden>{prompt}</p>
                      </Fragment>
                    )}
                  </div>
                </div>
              </Face>
            </li>
            );
          })}
        </ol>
      ))
    }
    <a class="foot absolute inset-x-0 bottom-0 flex h-22 items-center gap-6 rounded-card bg-paper px-6 whitespace-nowrap text-muted transition-colors duration-150 hover:text-ink max-sm:static max-sm:mt-4 max-sm:grid max-sm:h-auto max-sm:grid-cols-[repeat(2,max-content)] max-sm:gap-y-3 max-sm:p-4" href="/stats">
      <SkaleOnBase class="mr-auto h-8 w-auto shrink-0 text-ink max-sm:col-span-full" role="img" aria-label="SKALE on Base" />
      {
        totals && (
          <Fragment>
            <p class="flex flex-col text-caption/4">
              <b class="text-[16px]/5.5 font-medium text-ink">{count(totals.trades)}</b>
              agentic trades settled
            </p>
            <p class="flex flex-col text-caption/4">
              <b class="text-[16px]/5.5 font-medium text-ink">{dollars(totals.volume)}</b>
              paper volume
            </p>
          </Fragment>
        )
      }
    </a>
  </div>
  <script is:inline set:html={hero} />
</div>

<style>
  @property --p {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 100%;
  }

  .row:has([aria-pressed="true"]) {
    background: linear-gradient(to right, var(--color-paper) var(--p), color-mix(in oklab, var(--color-paper) 50%, transparent) var(--p));
    color: var(--color-ink);
  }

  .row:not(:has([aria-pressed="true"])) .pm {
    display: none;
  }

  .row:hover {
    color: var(--color-ink);
  }

  .row :global(.glyph),
  .pm {
    border-radius: calc(infinity * 1px);
  }

  @media (min-width: 1024px) {
    :is(.row, .more) {
      --inset: 5px;
      padding: var(--inset) 12px var(--inset) var(--inset);
      container-type: size;
    }

    .row :global(.glyph),
    .pm {
      border-radius: calc(var(--radius-card) - var(--inset));
    }
  }

  .pit:has(:is(.tk, .timing):is(:hover, :focus-within)) .timing {
    animation-play-state: paused;
  }

  .fan {
    --w: min(250px, 34cqi);
    --seam: 68px;
    --notch: 8px;
    --ease: cubic-bezier(0.2, 0, 0, 1);
    position: relative;
    isolation: isolate;
    min-width: 0;
    height: 480px;
    container-type: inline-size;
  }

  .hand {
    position: absolute;
    inset: 0 0 104px;
    z-index: 1;
  }

  .out > .hand {
    opacity: 0;
  }

  .tk {
    --x: 0px;
    --y: 32px;
    --r: 0deg;
    --n: 0;
    --lift: -8px;
    position: absolute;
    bottom: var(--y);
    left: calc(50% - var(--w) / 2 + var(--x));
    z-index: 3;
    width: var(--w);
    height: 336px;
    container-type: inline-size;
    transform-origin: 50% 100%;
    rotate: var(--r);
  }

  .tk:nth-child(2) {
    --x: calc(var(--w) * -0.84);
    --y: 12px;
    --r: -5deg;
    --n: 1;
    z-index: 2;
  }

  .tk:nth-child(3) {
    --x: calc(var(--w) * 0.84);
    --y: 12px;
    --r: 5deg;
    --n: 2;
    z-index: 1;
  }

  .face {
    --at: var(--seam);
    --hole: #0000 var(--notch), #000 calc(var(--notch) + 0.5px);
    position: relative;
    display: grid;
    grid-template: minmax(0, 1fr) / var(--seam) minmax(0, 1fr);
    height: 100%;
    border-radius: 16px;
    background: var(--color-paper);
    color: var(--color-ink);
    mask:
      radial-gradient(circle at var(--at) 0, var(--hole)),
      radial-gradient(circle at var(--at) 100%, var(--hole));
    mask-composite: intersect;
  }

  .tk:first-child .face {
    color-scheme: dark;
  }

  @media (prefers-color-scheme: dark) {
    .tk:first-child .face {
      color-scheme: light;
    }
  }

  .face:focus-visible {
    --color-line: var(--color-ink);
    outline: none;
  }

  .face::after {
    --ring: #0000 var(--notch), var(--color-line) calc(var(--notch) + 0.5px), var(--color-line) calc(var(--notch) + 1px), #0000 calc(var(--notch) + 1.5px);
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px var(--color-line);
    background:
      radial-gradient(circle at var(--at) 0, var(--ring)),
      radial-gradient(circle at var(--at) 100%, var(--ring));
  }

  .tear {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    width: var(--seam);
    padding-bottom: 16px;
  }

  .tear::before {
    content: "";
    position: absolute;
    inset: 16px 0 16px auto;
    border-left: 1px dashed color-mix(in oklab, var(--color-faint) 70%, transparent);
  }

  .hold {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 16px 0 46px;
  }

  .hold :global(.av),
  .bot {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: calc(infinity * 1px);
  }

  .bot {
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-line);
    color: var(--color-faint);
  }

  .who {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  .blank .who {
    color: var(--color-faint);
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 16px;
  }

  .side {
    width: fit-content;
    padding: 4px 12px;
    border-radius: var(--radius-control);
    background: #047857;
    color: #ffffff;
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
  }

  .side.no {
    background: #e11d48;
  }

  .name {
    display: -webkit-box;
    max-width: 100%;
    margin-top: 12px;
    overflow: hidden;
    font-size: 30px;
    line-height: 34px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: break-word;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .name.small {
    font-size: 24px;
    line-height: 28px;
  }

  .name.smaller {
    font-size: 20px;
    line-height: 24px;
  }

  .blank .name {
    color: var(--color-muted);
  }

  .body:has(.x-say:not([hidden])) .name {
    display: none;
  }

  .tally {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
  }

  .paid {
    font-size: 14px;
    line-height: 20px;
    color: var(--color-muted);
  }

  .pl {
    font-size: 40px;
    line-height: 44px;
    font-weight: 500;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .up {
    color: var(--color-up);
  }

  .down {
    color: var(--color-down);
  }

  .foot :global(rect) {
    fill: light-dark(#0000ff, #4060ff);
  }

  @keyframes hero-fill {
    from {
      --p: 0%;
    }
  }

  @keyframes hero-fan {
    from {
      opacity: 0;
      translate: calc(var(--x) * -1) 32px;
      rotate: 0deg;
    }
  }

  @container (max-width: 230px) {
    .face {
      --seam: 54px;
    }

    .hold {
      padding-bottom: 42px;
    }

    .hold :global(.av),
    .bot {
      width: 32px;
      height: 32px;
    }

    .who {
      font-size: 14px;
    }

    .body {
      padding: 14px 12px;
    }

    .name {
      font-size: 24px;
      line-height: 28px;
    }

    .pl {
      font-size: 32px;
      line-height: 36px;
    }

    .copy :global(svg) {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .tk:nth-child(3) .face {
      --at: calc(100% - var(--seam));
      grid-template-columns: minmax(0, 1fr) var(--seam);
    }

    .tk:nth-child(3) .hold {
      order: 1;
    }

    .tk:nth-child(3) .tear {
      inset: 0 0 0 auto;
    }

    .tk:nth-child(3) .tear::before {
      inset: 16px auto 16px 0;
    }

    .tk:nth-child(3) :is(.body, .tally) {
      align-items: flex-end;
      text-align: right;
    }
  }

  @media (max-width: 639px) {
    .fan {
      height: auto;
    }

    .hand {
      position: static;
      display: grid;
      gap: 20px;
    }

    .tk:nth-child(n) {
      --x: 0px;
      --lift: -4px;
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
    }

    .tk:nth-child(1) {
      --r: -1.5deg;
    }

    .tk:nth-child(2) {
      --r: 1deg;
    }

    .tk:nth-child(3) {
      --r: -1deg;
    }

    .blank ~ .blank {
      display: none;
    }

    .face {
      min-height: 208px;
    }

    .name {
      font-size: 26px;
      line-height: 30px;
      -webkit-line-clamp: 2;
    }

    .pl {
      font-size: 34px;
      line-height: 38px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .timing {
      animation: hero-fill 5s linear forwards;
    }

    .hand {
      transition: opacity 200ms ease-out;
    }

    .tk {
      transition:
        translate 300ms var(--ease),
        rotate 300ms var(--ease);
      animation: hero-fan 600ms var(--ease) calc(var(--n) * 120ms) backwards;
    }

    .tk:is(:hover, :has(.face:focus-visible)) {
      translate: 0 var(--lift);
      rotate: calc(var(--r) / 2);
    }

  }
</style>
