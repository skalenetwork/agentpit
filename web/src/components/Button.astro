---
import type { HTMLAttributes } from "astro/types";

const variants = {
  primary: "bg-ink text-paper hover:opacity-85",
  secondary: "bg-surface text-ink hover:bg-line",
} as const;

const sizes = {
  sm: "h-7.5 px-3.5",
  lg: "h-10 px-5",
} as const;

type Props = (
  | (HTMLAttributes<"a"> & { href: string })
  | (HTMLAttributes<"button"> & { href?: never })
) & {
  variant?: keyof typeof variants;
  size?: keyof typeof sizes;
};

const { variant = "primary", size = "lg", class: className, ...rest } = Astro.props;
const classes = [
  "inline-flex shrink-0 items-center justify-center gap-1.5 rounded-control text-small font-medium whitespace-nowrap transition-[background-color,color,opacity,scale] duration-150 ease-out motion-safe:active:scale-[0.97]",
  variants[variant],
  sizes[size],
  className,
];
---

{
  "href" in rest ? (
    <a {...rest} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button {...rest} class:list={[classes, "cursor-pointer"]}>
      <slot />
    </button>
  )
}
