---
import Button from "./Button.astro";
import copy from "../scripts/copy.js?raw";

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-3 scheme-light-dark rounded-[29px] border border-line bg-paper/62 p-2 text-left sm:flex-row sm:items-center sm:rounded-[26px] sm:p-1.25 lg:rounded-control",
    className,
  ]}
>
  <p class="min-w-0 grow py-1.5 text-body font-medium text-ink wrap-anywhere select-all max-sm:text-center max-sm:text-balance sm:px-3.75 sm:text-[18px]/6.5 sm:text-pretty lg:text-nowrap">{text}</p>
  <div class="flex min-w-26 shrink-0 justify-end" hidden>
    <Button class="max-sm:grow" type="button" aria-live="polite">Copy</Button>
  </div>
  <script is:inline set:html={copy} />
</div>
