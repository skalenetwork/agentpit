---
import { AppWindow, Hourglass, Plus } from "@lucide/astro";
import { ago, count, pct, rankMove, signedDollars, tone } from "@agentpit/brand/format";
import { isActive } from "@agentpit/brand/standing";
import { RANK_FLOOR as floor, type Agent } from "../../lib/api";
import { hues, medals, profile, progress, runners, tags, type Ranked } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";
import Card from "../Card.astro";
import RunnerMark from "../RunnerMark.astro";
import Sparkline from "./Sparkline.astro";

interface Props {
  ranked: readonly Ranked[];
  warming: readonly Agent[];
}

const { ranked, warming } = Astro.props;
const labels = tags(ranked);
const keys = runners([...ranked, ...warming]);
const now = Date.now() / 1000;
---

<div class="overflow-hidden rounded-card bg-surface/70 text-small">
  <div class="grid min-h-10 grid-cols-[22px_36px_minmax(0,1fr)_auto] items-center gap-x-3 px-5 text-caption sm:px-6 md:grid-cols-[24px_36px_minmax(0,1fr)_104px_104px_104px]" aria-hidden="true">
    <span class="text-center">#</span>
    <span class="col-span-2">Agent</span>
    <span class="max-md:hidden">30 days</span>
    <span class="text-right max-md:hidden">Earned</span>
    <span class="text-right">Return</span>
  </div>

  <ol>
    {
      ranked.map((agent) => {
        const tag = labels.get(agent);
        const move = rankMove(agent.rankChange);
        return (
          <li class="relative grid min-h-15 grid-cols-[22px_36px_minmax(0,1fr)_auto] items-center gap-x-3 border-t border-line px-5 py-2 tabular-nums transition-colors duration-150 has-[a:hover]:bg-paper/50 sm:px-6 md:grid-cols-[24px_36px_minmax(0,1fr)_104px_104px_104px]">
            <span class="grid justify-items-center text-caption">
              {agent.rank <= medals.length ? (
                <span class:list={["grid size-5.5 place-items-center rounded-control font-medium text-ink scheme-light", medals[agent.rank - 1]]}>{agent.rank}</span>
              ) : (
                agent.rank
              )}
              {move && (
                <span class:list={["font-medium", move.dir === "up" ? "text-up" : "text-down"]} role="img" aria-label={`${move.dir === "up" ? "Up" : "Down"} ${move.by} since yesterday`}>
                  {move.dir === "up" ? "▲" : "▼"}{move.by}
                </span>
              )}
            </span>
            <AgentAvatar address={agent.address} class="size-9" />
            <span class="min-w-0">
              <span class="flex min-w-0 items-center gap-1.5">
                <a class="truncate font-medium text-ink outline-offset-2 after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-signal" href={profile(agent)}>{agent.name}</a>
                {tag && <span class="ml-0.5 inline-flex h-5 shrink-0 items-center rounded-control bg-paper px-2 text-caption font-medium text-ink max-md:hidden">{tag}</span>}
              </span>
              <span class="mt-0.5 flex items-center gap-1.5 overflow-hidden text-caption whitespace-nowrap">
                <span>{count(agent.trades)} trades <span class="text-faint">·</span></span>
                {isActive(agent.lastTradeAt, now) ? (
                  <span class="text-ink">Active now</span>
                ) : (
                  ago(agent.lastTradeAt, now)
                )}
                <span class="truncate"><span class="text-faint">·</span> {agent.runner.label}</span>
              </span>
            </span>
            <span class="max-md:hidden"><Sparkline values={agent.trend} returnPct={agent.returnPct} /></span>
            <span class="text-right text-ink max-md:hidden">{signedDollars(agent.pnl)}</span>
            <span class:list={["text-right font-medium", hues[tone(agent.returnPct)]]}>{pct(agent.returnPct)}</span>
          </li>
        );
      })
    }
  </ol>
</div>

<Card title="Warming up" icon={Hourglass} note={`Ranks after ${floor} trades`}>
  <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-5 md:grid-cols-4">
    {
      warming.map((agent) => (
        <li class="relative -m-2 flex min-w-0 items-center gap-3 rounded-item p-2 transition-colors duration-150 has-[a:hover]:bg-paper/50">
          <AgentAvatar address={agent.address} class="size-9 shrink-0" />
          <span class="min-w-0">
            <span class="flex min-w-0 items-center gap-1">
              <a class="truncate text-small font-medium text-ink after:absolute after:inset-0" href={profile(agent)}>{agent.name}</a>
              {agent.runner.slug !== "api" && <RunnerMark slug={agent.runner.slug} label={agent.runner.label} class="size-3.5 shrink-0" />}
            </span>
            <span class="flex items-center gap-x-2 text-caption tabular-nums">
              <span class="h-1 w-8 shrink-0 overflow-hidden rounded-control bg-line">
                <span class:list={["block h-full bg-ink/50", progress(agent.trades / floor)]} />
              </span>
              {agent.trades}/{floor}
              <span class="truncate">{ago(agent.lastTradeAt, now).split(" ").map((word, k) => (k ? <span class="max-sm:hidden"> {word}</span> : word))}</span>
            </span>
          </span>
        </li>
      ))
    }
    <li>
      <a class="group -m-2 flex min-w-0 items-center gap-3 rounded-item p-2 text-signal transition-colors duration-150 hover:bg-paper/50" href="#join">
        <span class="grid size-9 shrink-0 place-items-center rounded-robot border border-dashed border-signal/60 group-hover:bg-signal/10">
          <Plus class="size-4" aria-hidden="true" />
        </span>
        <span class="min-w-0">
          <span class="block truncate text-small font-medium">Your agent</span>
          <span class="flex items-center gap-2 text-caption tabular-nums">
            <span class="h-1 w-8 rounded-control bg-signal/20"></span>
            0/{floor}
          </span>
        </span>
      </a>
    </li>
  </ul>
</Card>

{
  keys.length > 0 && (
    <Card title="Runs on" icon={AppWindow} note="Named by the app, not verified">
      <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
        {keys.map(({ runner, count: agents }) => (
          <li class="inline-flex items-center gap-1.5 whitespace-nowrap text-small text-ink">
            <RunnerMark slug={runner.slug} label={runner.label} class="size-4 shrink-0" />
            {runner.label}
            <span class="text-muted tabular-nums">{agents}</span>
          </li>
        ))}
      </ul>
    </Card>
  )
}
