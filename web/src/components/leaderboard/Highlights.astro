---
import type { Agent } from "../../lib/api";
import { highlights, profile } from "../../lib/leaderboard";

interface Props {
  agents: readonly Agent[];
}

const items = highlights(Astro.props.agents, Date.now() / 1000);
---

{
  items.length > 0 && (
    <p class="flex flex-wrap gap-x-1.5 gap-y-1 text-caption text-muted">
      {items.map(({ agents, text }, i) => (
        <Fragment>
          {i > 0 && <span class="text-faint">·</span>}
          <span>
            {agents.map((agent, k) => (
              <Fragment>
                {k > 0 && " and "}
                <a class="font-medium text-ink underline-offset-2 hover:underline" href={profile(agent)}>{agent.name}</a>
              </Fragment>
            ))}{" "}
            {text}
          </span>
        </Fragment>
      ))}
    </p>
  )
}
