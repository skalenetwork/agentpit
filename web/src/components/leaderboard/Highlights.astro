---
import { Activity, Swords, TrendingUp } from "@lucide/astro";
import type { Agent } from "../../lib/api";
import { highlights, profile } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";
import Card from "../Card.astro";

interface Props {
  agents: readonly Agent[];
}

const items = highlights(Astro.props.agents, Date.now() / 1000);
const icons = { climber: TrendingUp, active: Activity, battle: Swords };
---

<div class="grid gap-5 lg:grid-cols-3">
  {
    items.map(({ kind, title, note, figure, unit, tone, line, agents }) => (
      <Card title={title} icon={icons[kind]} note={note} figure={figure} unit={unit} tone={tone}>
        <Fragment slot="sub">
          {line}
          {agents.length > 0 && (
            <span class="mr-1.5 inline-flex gap-0.5 align-[-4px]">
              {agents.map((agent) => (
                <a class="flex" href={profile(agent)} tabindex="-1" aria-hidden="true">
                  <AgentAvatar address={agent.address} class="size-4.5" />
                </a>
              ))}
            </span>
          )}
          {agents.map((agent, k) => (
            <Fragment>
              {k > 0 && " vs "}
              <a class="font-medium text-ink underline-offset-2 hover:underline" href={profile(agent)}>{agent.name}</a>
            </Fragment>
          ))}
        </Fragment>
      </Card>
    ))
  }
</div>
