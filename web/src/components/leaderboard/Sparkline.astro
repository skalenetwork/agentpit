---
import { sparkline } from "@agentpit/brand/chart";
import { tone } from "@agentpit/brand/format";
import { TREND_DAYS } from "../../lib/api";
import { hues } from "../../lib/leaderboard";

interface Props {
  values: readonly number[];
  returnPct: number;
}

const { values, returnPct } = Astro.props;
const line = sparkline(values, TREND_DAYS);
---

{
  line && (
    <svg class:list={["h-7 w-24", hues[tone(returnPct)]]} viewBox="0 0 96 28" aria-hidden="true">
      <polyline class="fill-none stroke-current" points={line.points} stroke-width="1.5" stroke-linejoin="round" />
      <circle class="fill-paper stroke-current" cx={line.end.x} cy={line.end.y} r="2.5" stroke-width="1.5" />
    </svg>
  )
}
