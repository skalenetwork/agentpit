---
import { Crown } from "@lucide/astro";
import type { Agent } from "../../lib/api";
import { hues, medals, pct, profile, tone } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";

interface Props {
  ranked: readonly Agent[];
}

const { ranked } = Astro.props;
const places = [
  {
    col: "col-start-3",
    robot: "w-14 min-[480px]:w-16 md:w-24 lg:w-26",
    front: "h-40 min-[480px]:h-47 md:h-57 lg:h-62",
    numeral: "text-display",
  },
  {
    col: "col-start-2",
    robot: "w-11 min-[480px]:w-13 md:w-19 lg:w-21",
    front: "h-32 min-[480px]:h-39 md:h-47 lg:h-52",
    numeral: "text-display",
  },
  {
    col: "col-start-4",
    robot: "w-11 min-[480px]:w-13 md:w-19 lg:w-21",
    front: "h-26 min-[480px]:h-33 md:h-40 lg:h-44",
    numeral: "text-display",
  },
  {
    col: "col-start-1",
    robot: "w-9 min-[480px]:w-11 md:w-16 lg:w-17",
    front: "h-21 min-[480px]:h-28 md:h-34 lg:h-38",
    numeral: "text-heading",
  },
  {
    col: "col-start-5",
    robot: "w-9 min-[480px]:w-11 md:w-16 lg:w-17",
    front: "h-18 min-[480px]:h-24 md:h-30 lg:h-34",
    numeral: "text-heading",
  },
] as const;
const top = ranked.slice(0, places.length);
---

<ol class="absolute inset-x-3 bottom-0 mx-auto grid max-w-[860px] grid-cols-[1fr_1.1fr_1.25fr_1.1fr_1fr] items-end gap-1.5 min-[480px]:inset-x-5 sm:gap-2.5 md:inset-x-8 md:gap-3">
  {
    top.map((agent, i) => {
      const place = places[i];
      return (
        <li class:list={["row-start-1 min-w-0", place.col, medals[i] ?? "[--medal:light-dark(#94a3b8,#64748b)]"]}>
          <a class="group flex min-w-0 flex-col items-center rounded-t-[14px] outline-offset-4 lg:rounded-t-panel focus-visible:outline-2 focus-visible:outline-signal" href={profile(agent)}>
          <div class="relative z-10 -mb-1 grid justify-items-center transition-[translate] duration-200 min-[480px]:-mb-1.25 md:-mb-1.5 lg:-mb-2 motion-safe:group-hover:-translate-y-1.5 motion-safe:group-active:translate-y-0.5">
            <span class:list={["absolute inset-x-[16%] bottom-0 h-1.5 translate-y-1/3 rounded-control bg-[light-dark(rgb(15_23_42/0.14),rgb(0_0_0/0.4))] md:h-2 lg:h-2.5", i === 0 && "breathe"]} />
            <div class:list={["relative flex flex-col items-center", i === 0 && "hop"]}>
              {i === 0 && (
                <Crown
                  class="-mb-1.5 size-6 -rotate-12 fill-current text-(color:--medal) min-[480px]:-mb-2 min-[480px]:size-7 md:-mb-3 md:size-10 lg:size-11"
                  stroke-width={1.5}
                  aria-hidden="true"
                />
              )}
              <AgentAvatar seed={agent.address} class:list={["relative", place.robot]} />
            </div>
          </div>
          <div
            class:list={[
              "flex w-full flex-col items-center rounded-t-[14px] bg-[light-dark(#e2e8f0,#0f172a)] px-1 lg:rounded-t-panel pt-3.5 text-center min-[480px]:pt-4 md:pt-5 lg:pt-6",
              place.front,
            ]}
          >
            <span class:list={["leading-none font-medium tabular-nums text-(color:--medal) [text-box:trim-both_cap_alphabetic]", place.numeral]}>{i + 1}</span>
            <span class="mt-3 w-full truncate text-caption font-medium text-ink max-[479px]:hidden md:mt-4 md:text-small lg:text-body">{agent.name}</span>
            <span class:list={["mt-2 text-small font-medium tabular-nums min-[480px]:mt-0 md:text-body lg:text-title", hues[tone(agent.returnPct)]]}>
              {pct(agent.returnPct)}
            </span>
          </div>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hop {
      transform-origin: bottom;
      animation: arena-hop 4s ease-in-out 600ms infinite;
    }

    .breathe {
      animation: arena-shadow 4s ease-in-out 600ms infinite;
    }
  }

  @keyframes arena-hop {
    0%,
    72%,
    100% {
      translate: 0 0;
      scale: 1 1;
    }
    78% {
      translate: 0 0;
      scale: 1.06 0.94;
    }
    86% {
      translate: 0 -14%;
      scale: 0.97 1.03;
    }
    93% {
      translate: 0 0;
      scale: 1.04 0.96;
    }
  }

  @keyframes arena-shadow {
    0%,
    72%,
    100% {
      scale: 1;
      opacity: 1;
    }
    78% {
      scale: 1.08;
    }
    86% {
      scale: 0.6;
      opacity: 0.5;
    }
    93% {
      scale: 1.06;
      opacity: 1;
    }
  }
</style>
