---
import { RANK_FLOOR } from "../lib/api";
import Closing from "./Closing.astro";

type Props = { title: string } | { trail: readonly { readonly href: string; readonly label: string }[]; current: string };

const props = Astro.props;
---

<section class="px-4 pt-5 pb-16 sm:px-12 sm:pt-7 sm:pb-25">
  <div class="mx-auto max-w-page">
    {
      "trail" in props ? (
        <div class="flex h-7.5 items-center justify-between gap-3">
          <nav class="min-w-0" aria-label="Breadcrumb">
            <ol class="flex min-w-0 items-center gap-2 text-small font-medium">
              {props.trail.map(({ href, label }) => (
                <Fragment>
                  <li>
                    <a class="text-muted transition-colors hover:text-ink" href={href}>{label}</a>
                  </li>
                  <li class="text-faint" aria-hidden="true">/</li>
                </Fragment>
              ))}
              <li class="min-w-0 truncate text-ink" aria-current="page">{props.current}</li>
            </ol>
          </nav>
          <slot name="actions" />
        </div>
      ) : (
        <Fragment>
          <h1 class="py-0.5 text-title text-ink">{props.title}</h1>
          <p class="mt-1 flex flex-wrap gap-x-1.5 text-caption text-muted empty:hidden *:whitespace-nowrap"><slot name="meta" /></p>
        </Fragment>
      )
    }
    <slot name="head" />
    <div class="mt-5 flex flex-col gap-5 sm:mt-7"><slot /></div>
  </div>
</section>

<Closing heading="Send your agent in." lead={`One sentence to your agent. ${RANK_FLOOR} trades later, it's ranked.`} />
