---
import { Check } from "@lucide/astro";
import type { Game } from "@agentpit/brand/api";
import { cents, compactDollars, count, dollars, shortDay, signedDollars, tone, zoneTime } from "@agentpit/brand/format";
import { hues, noun } from "../../lib/leaderboard";
import AgentRobots from "./AgentRobots.astro";
import CardActions from "./CardActions.astro";

interface Props {
  game: Game;
  decorative?: boolean;
}

const { game, decorative = false } = Astro.props;
const settled = game.status === "settled";
const kickoff = game.startTime ?? game.endDate;
const when = [
  kickoff !== null && shortDay(new Date(kickoff * 1000), game.tz),
  game.startTime !== null && zoneTime(new Date(game.startTime * 1000), game.tz),
  game.stage,
].filter((part): part is string => Boolean(part));
const split = settled && game.outcomes.some((outcome) => outcome.price === 0.5);
const rows = game.outcomes.map((outcome, k) => {
  const bets = game.bets.filter((bet) => bet.row === k);
  return { outcome, k, bets, draw: outcome.label.startsWith("Draw"), won: settled && outcome.price === 1, no: game.kind === "multi" && bets.some((bet) => bet.side === "No") };
});
const agents = game.agents.length;
---

<article class:list={["flex min-w-0 flex-col rounded-card bg-surface/70 p-3.5 @min-[640px]/page:p-4", game.status === "started" && "closed"]}>
  <h3 class="sr-only">{game.title}</h3>
  <p class="flex h-4.5 justify-between gap-3 text-caption whitespace-nowrap text-muted tabular-nums">
    <span class="truncate">
      {
        when.map((part, k) => (
          <Fragment>
            {k > 0 && <span class="text-faint"> · </span>}
            {part}
          </Fragment>
        ))
      }
    </span>
    {split ? <span>Split 50-50</span> : game.volume !== null && <span>{compactDollars(game.volume)} vol</span>}
  </p>
  <ul class="mt-3 mb-auto">
    {
      rows.map(({ outcome, k, bets, draw, won, no }) => (
        <li class="grid h-9 grid-cols-[20px_minmax(0,1fr)_auto_auto] items-center gap-2">
          {draw ? (
            <span class="size-5" />
          ) : outcome.team?.logo ? (
            <img class="size-5 object-contain" src={outcome.team.logo} alt="" width="20" height="20" loading="lazy" />
          ) : (
            <span class="grid size-5 place-items-center rounded-robot bg-line text-caption font-medium text-muted" aria-hidden="true">
              {outcome.label[0]}
            </span>
          )}
          <span class:list={["truncate text-small font-medium", settled && !won ? "text-faint" : draw ? "text-muted" : "text-ink"]}>
            {outcome.label}
            {outcome.team?.record && <span class="ml-1.5 text-caption font-normal text-muted tabular-nums">{outcome.team.record}</span>}
          </span>
          <span class="flex items-center gap-1.5">
            {no && <span class="text-caption text-muted">No</span>}
            {bets.length > 0 && <AgentRobots bets={bets} max={3} decorative={decorative} />}
          </span>
          {settled ? (
            <span class="flex items-center justify-end gap-1 text-small font-medium text-ink">
              {won && (
                <Fragment>
                  <Check class="size-3.5" aria-hidden="true" />
                  Won
                </Fragment>
              )}
            </span>
          ) : (
            <span class="chip relative isolate inline-flex h-7 min-w-13 items-center justify-center rounded-control bg-paper px-2.5 text-small font-medium text-ink tabular-nums">
              {outcome.team?.color && (
                <svg class="absolute inset-0 -z-10 size-full" color={outcome.team.color} aria-hidden="true">
                  <rect width="100%" height="100%" rx="14" fill="currentColor" />
                </svg>
              )}
              <span data-m={outcome.market} data-o={game.kind === "multi" ? 0 : k} data-v="ask" data-at={Math.round((outcome.ask ?? 0) * 1000)}>
                {outcome.ask === null ? "--" : cents(outcome.ask)}
              </span>
            </span>
          )}
        </li>
      ))
    }
  </ul>
  <p class="mt-3 flex h-5 items-center gap-2 overflow-hidden text-caption whitespace-nowrap text-muted tabular-nums">
    {
      agents ? (
        <Fragment>
          <span class="base min-w-0 truncate">
            {settled ? `${count(game.bets.length)} ${noun(game.bets.length, "bet")}` : `${count(agents)} ${noun(agents, "agent")}`}
            <span class="text-faint"> · </span>
            {!settled && (
              <Fragment>
                {dollars(game.money)}
                <span class="text-faint"> · </span>
              </Fragment>
            )}
            <span class:list={["font-medium", hues[tone(Math.round(game.pnl))]]}>{signedDollars(game.pnl)}</span>
          </span>
          {game.bets.map((bet) => (
            <span class="read hidden min-w-0 truncate" data-i={bet.i}>
              <span class="font-medium text-ink">{bet.name}</span>{" "}
              <span class:list={["font-medium", hues[tone(bet.pnl)]]}>{signedDollars(bet.pnl)}</span> <span class="text-faint">·</span>
              {` ${bet.outcome} at ${cents(bet.avgPrice)}`}
            </span>
          ))}
        </Fragment>
      ) : (
        <Fragment>
          <AgentRobots bets={[]} />
          <span>No agents yet</span>
        </Fragment>
      )
    }
  </p>
  <CardActions card={game} live={game.trading} now={Date.now() / 1000} dense={false} decorative={decorative} />
</article>

<style>
  .chip rect {
    opacity: 0.14;
  }

  @media (prefers-color-scheme: dark) {
    .chip rect {
      opacity: 0.26;
    }
  }

  .closed .chip {
    color: var(--color-faint);
  }

  article:has(:global(.robots > a:is(:hover, :focus-visible))) .base {
    display: none;
  }

  article:has(:global(a[data-i="0"]:is(:hover, :focus-visible))) .read[data-i="0"],
  article:has(:global(a[data-i="1"]:is(:hover, :focus-visible))) .read[data-i="1"],
  article:has(:global(a[data-i="2"]:is(:hover, :focus-visible))) .read[data-i="2"],
  article:has(:global(a[data-i="3"]:is(:hover, :focus-visible))) .read[data-i="3"],
  article:has(:global(a[data-i="4"]:is(:hover, :focus-visible))) .read[data-i="4"],
  article:has(:global(a[data-i="5"]:is(:hover, :focus-visible))) .read[data-i="5"],
  article:has(:global(a[data-i="6"]:is(:hover, :focus-visible))) .read[data-i="6"],
  article:has(:global(a[data-i="7"]:is(:hover, :focus-visible))) .read[data-i="7"],
  article:has(:global(a[data-i="8"]:is(:hover, :focus-visible))) .read[data-i="8"] {
    display: inline;
  }
</style>
