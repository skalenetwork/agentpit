---
import { type Card, phase } from "@agentpit/brand/api";
import { cents, chance, count, dollars, rankMove, signedDollars, tone } from "@agentpit/brand/format";
import { hues, noun } from "../../lib/leaderboard";
import Glyph from "../agent/Glyph.astro";
import AgentRobots from "./AgentRobots.astro";
import CardActions from "./CardActions.astro";

interface Props {
  card: Card;
  decorative?: boolean;
}

const MAX = 6;
const { card, decorative = false } = Astro.props;
const now = Date.now() / 1000;
const settled = card.state === "settled";
const lead = card.outcomes[card.lead];
const leads = card.bets.filter((bet, i, all) => all.findIndex((other) => other.agent === bet.agent) === i).toSorted((a, b) => Number(a.lost) - Number(b.lost));
const reads = leads.length > MAX ? leads.slice(0, MAX - 1) : leads;
const agents = card.agents.length;
const label = !settled
  ? card.kind === "binary"
    ? "Yes"
    : lead.label
  : lead.price === 0.5
    ? card.kind === "multi"
      ? `${lead.label} split 50-50`
      : "Split 50-50"
    : card.kind === "binary"
      ? `${lead.price === 1 ? "Yes" : "No"} won`
      : card.kind !== "multi" || lead.price === 1
        ? `${lead.label} won`
        : `${card.outcomes[card.bets[0]?.row ?? card.lead].label} resolved No`;
const move = !settled && lead.change24h !== null ? rankMove(Math.round(lead.change24h * 100)) : null;
const fill = `${Math.round((lead.price ?? 0) * 1000) / 10}%`;
const live = { "data-m": lead.market, "data-o": card.kind === "multi" ? 0 : card.lead, "data-at": Math.round((lead.price ?? 0) * 1000) };
---

<article class:list={["flex min-w-0 flex-col rounded-card bg-surface/70 p-3.5 @min-[640px]/page:p-4", phase(card, null, now)?.kind === "awaiting" && "closed"]}>
  <div class="flex h-10 items-center gap-3">
    <Glyph class="size-8" title={card.title} icon={card.icon} category={card.category} />
    <h3 class="flex h-10 min-w-0 items-center text-small font-medium text-ink"><span class="line-clamp-2 text-pretty">{card.title}</span></h3>
  </div>
  <p class="mt-5 h-5 truncate text-label font-medium text-muted">{label}</p>
  {
    settled ? (
      <p class:list={["mt-2 h-10 text-stat whitespace-nowrap tabular-nums", hues[tone(card.pnl)]]}>{signedDollars(card.pnl)}</p>
    ) : (
      <Fragment>
        <p class="mt-2 flex h-10 items-baseline gap-2 whitespace-nowrap tabular-nums">
          <span class="chance text-stat text-ink" {...live} data-v="mid">{chance(lead.price)}</span>
          {move && (
            <span class:list={["move text-label font-medium", move.dir === "up" ? "text-up" : "text-down"]} role="img" aria-label={`${move.dir === "up" ? "Up" : "Down"} ${move.by} ${noun(move.by, "point")} in 24 hours`}>
              {move.dir === "up" ? "▲" : "▼"} {move.by}
            </span>
          )}
        </p>
        <svg class="mt-3 block h-1.5 w-full" aria-hidden="true">
          <rect class="fill-line" width="100%" height="6" rx="3" />
          <rect class="bar fill-ink" width={fill} height="6" rx="3" {...live} data-v="bar" />
        </svg>
      </Fragment>
    )
  }
  <div class="mt-4 flex h-5"><AgentRobots bets={leads} max={MAX} decorative={decorative} /></div>
  <p class="mt-1.5 flex h-4.5 min-w-0 overflow-hidden text-caption whitespace-nowrap text-muted tabular-nums">
    <span class="base min-w-0 truncate">
      {
        !agents ? (
          "No agents yet"
        ) : settled ? (
          `${dollars(card.money)} paid`
        ) : (
          <Fragment>
            {`${count(agents)} ${noun(agents, "agent")} `}
            <span class="text-faint">·</span>
            {` ${dollars(card.money)} `}
            <span class="text-faint">·</span>
            {" "}
            <span class:list={["font-medium", hues[tone(card.pnl)]]}>{signedDollars(card.pnl)}</span>
          </Fragment>
        )
      }
    </span>
    {
      reads.map((bet) => (
        <span class="read hidden min-w-0 truncate">
          <span class="font-medium text-ink">{bet.name}</span>
          {" "}
          <span class:list={["font-medium", hues[tone(bet.pnl)]]}>{signedDollars(bet.pnl)}</span>
          {" "}
          <span class="text-faint">·</span>
          {` ${bet.outcome} at ${cents(bet.avgPrice)}`}
        </span>
      ))
    }
  </p>
  <CardActions card={card} live={card.trading} now={now} decorative={decorative} />
</article>

<style>
  .closed .chance {
    color: var(--color-muted);
  }

  .closed .bar {
    fill: var(--color-faint);
  }

  .closed .move {
    display: none;
  }

  article:has(:global(.robots > a:is(:hover, :focus-visible))) .base {
    display: none;
  }

  article:has(:global(.robots > a:nth-child(1):is(:hover, :focus-visible))) .read:nth-child(2),
  article:has(:global(.robots > a:nth-child(2):is(:hover, :focus-visible))) .read:nth-child(3),
  article:has(:global(.robots > a:nth-child(3):is(:hover, :focus-visible))) .read:nth-child(4),
  article:has(:global(.robots > a:nth-child(4):is(:hover, :focus-visible))) .read:nth-child(5),
  article:has(:global(.robots > a:nth-child(5):is(:hover, :focus-visible))) .read:nth-child(6),
  article:has(:global(.robots > a:nth-child(6):is(:hover, :focus-visible))) .read:nth-child(7) {
    display: inline;
  }
</style>
