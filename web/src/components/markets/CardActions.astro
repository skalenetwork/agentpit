---
import { Check, Clock, Copy } from "@lucide/astro";
import { agentPrompt, type Card, phase, phaseText } from "@agentpit/brand/api";
import { ET, zoneTime } from "@agentpit/brand/format";
import Polymarket from "@agentpit/brand/polymarket.svg";

interface Props {
  card: Card;
  live: boolean | null;
  now: number;
  dense?: boolean;
  decorative?: boolean;
}

const { card, live, now, dense = true, decorative = false } = Astro.props;
const status = phase(card, live, now);
const open = status?.kind !== "awaiting" && status?.kind !== "settled";
const [lead, value] = status ? phaseText(status, now) : [""];
const tick = (status?.kind === "starts" || status?.kind === "closes") && value !== undefined ? status : null;
const after = tick && phase(card, live, tick.at);
const final = after?.kind === "closes" ? phase(card, live, after.at) : after;
const clock = (at: number) => zoneTime(new Date(at * 1000), ET);
const range = card.kind === "window" && card.startTime !== null && card.endDate !== null && card.endDate - card.startTime < 86_400 ? `${clock(card.startTime).slice(0, 5)} to ${clock(card.endDate)}` : null;
const pill = [
  "inline-flex h-7.5 min-w-0 items-center justify-center gap-1.5 rounded-control px-3 text-small font-medium whitespace-nowrap transition-[background-color,color,opacity,scale] duration-150 ease-out motion-safe:active:scale-[0.97]",
  dense && "@min-[1176px]/page:px-2.5 @min-[1176px]/page:text-label",
];
---

{
  status && (
    <p class="mt-3 flex h-8 justify-between gap-3 border-t border-line pt-2.5 text-caption whitespace-nowrap text-muted tabular-nums">
      <span class="flex shrink-0 items-center gap-1.5">
        <Clock class="size-3" aria-hidden="true" />
        <span>
          {tick ? (
            <Fragment>
              {`${lead} `}
              <time
                class="font-medium text-ink"
                datetime={new Date(tick.at * 1000).toISOString()}
                data-at={tick.at}
                data-next={after?.kind === "closes" ? after.at : undefined}
                data-then={final && phaseText(final, now)[0]}
              >
                {value}
              </time>
            </Fragment>
          ) : (
            lead
          )}
        </span>
      </span>
      {range && <span class="min-w-0 truncate">{range}</span>}
    </p>
  )
}
{
  !decorative && (
    <div class="@container/actions mt-2.5 grid grid-cols-[minmax(0,1fr)_auto] gap-2">
      {
        open && (
          <button class:list={[pill, "cursor-pointer bg-ink text-paper hover:opacity-85 [&:has(+.x-say)]:col-span-full"]} type="button" data-copy aria-label={`Copy prompt, ${card.title}`} hidden>
            <span class="x-rest inline-flex items-center gap-1.5">
              <Copy class="hidden size-3.5 shrink-0 @min-[264px]/actions:block" aria-hidden="true" />
              Copy prompt
            </span>
            <span class="x-done inline-flex items-center gap-1.5" hidden>
              <Check class="size-3.5 shrink-0" aria-hidden="true" />
              Copied
            </span>
          </button>
        )
      }
      {
        card.url && (
          <a
            class:list={[
              "group/pm relative bg-paper text-ink hover:bg-line",
              open
                ? "col-start-2 grid size-7.5 place-items-center rounded-control transition-[background-color,scale] duration-150 ease-out motion-safe:active:scale-[0.97]"
                : [pill, "col-span-full"],
            ]}
            href={card.url}
            target="_blank"
            rel="noopener"
            aria-label={`Open in Polymarket, ${card.title}, new tab`}
          >
            <Polymarket class="size-3.5 shrink-0" aria-hidden="true" />
            {open ? (
              <span
                class="pointer-events-none absolute right-0 bottom-full mb-2 origin-bottom-right scale-[0.98] rounded-item bg-paper px-2.5 py-1.5 text-caption font-medium whitespace-nowrap text-ink opacity-0 shadow-overlay transition-[opacity,scale] duration-50 ease-out group-hover/pm:scale-100 group-hover/pm:opacity-100 group-hover/pm:delay-80 group-hover/pm:duration-150 group-focus-visible/pm:scale-100 group-focus-visible/pm:opacity-100 motion-reduce:transition-none"
                aria-hidden="true"
              >
                Open in Polymarket
              </span>
            ) : (
              "Open in Polymarket"
            )}
          </a>
        )
      }
      {open && <p class="x-say col-span-full text-caption text-ink wrap-anywhere" hidden>{agentPrompt(card)}</p>}
    </div>
  )
}
