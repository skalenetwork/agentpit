---
import { Bot, CircleCheck, Flame, Hourglass, TrendingUp } from "@lucide/astro";
import type { BoardTab } from "@agentpit/brand/api";

interface Props {
  tabs: readonly BoardTab[];
  current: string;
}

const { tabs, current } = Astro.props;
const icons: Readonly<Record<string, typeof Flame>> = { trending: Flame, movers: TrendingUp, agents: Bot, ending: Hourglass, settled: CircleCheck };
---

<nav
  class="sticky top-15 z-9 mt-5 bg-paper/60 text-small shadow-[inset_0_-1px_var(--color-line)] backdrop-blur-xl @max-[640px]/page:-mx-4 @min-[640px]/page:mt-7"
  aria-label="Market tabs"
>
  <div
    id="x-tabs"
    class="flex h-11 gap-6 overflow-x-auto overscroll-x-contain px-4 [scroll-padding-inline:24px] [scrollbar-width:none] @min-[640px]/page:-mx-1.5 @min-[640px]/page:px-1.5"
  >
    {
      tabs.map((tab, k) => {
        const Icon = icons[tab.key];
        const here = tab.key === current;
        return (
          <Fragment>
            {tab.category && k > 0 && !tabs[k - 1].category && <span class="h-3.5 w-px shrink-0 self-center bg-line" aria-hidden="true" />}
            <a
              class="relative inline-flex shrink-0 items-center gap-1.5 font-medium whitespace-nowrap text-muted transition-colors duration-150 hover:text-ink aria-[current=page]:text-ink focus-visible:outline-none focus-visible:before:absolute focus-visible:before:-inset-x-1.5 focus-visible:before:inset-y-2 focus-visible:before:rounded-item focus-visible:before:outline-2 focus-visible:before:outline-signal"
              href={tab.key === "trending" ? "/markets" : `/markets/${tab.key}`}
              aria-current={here ? "page" : undefined}
            >
              {Icon && <Icon class="size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />}
              {tab.label}
              {here && <span class="absolute inset-x-0 bottom-0 h-0.5 bg-ink [view-transition-name:tabline]" />}
            </a>
          </Fragment>
        );
      })
    }
  </div>
</nav>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(root) {
      animation: none;
    }

    ::view-transition-group(tabline) {
      animation-duration: 250ms;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @property --tabs-start {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @property --tabs-end {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @keyframes tabs-fade {
    from {
      --tabs-end: 24px;
    }
    10%,
    90% {
      --tabs-start: 24px;
      --tabs-end: 24px;
    }
    to {
      --tabs-start: 24px;
    }
  }

  @supports (animation-timeline: scroll()) {
    #x-tabs {
      mask-image: linear-gradient(to right, transparent, #000 var(--tabs-start), #000 calc(100% - var(--tabs-end)), transparent);
      animation: tabs-fade linear both;
      animation-timeline: scroll(self inline);
    }
  }
</style>
