---
interface Fact {
  term: string;
  def: string;
}

interface Props {
  facts: readonly Fact[];
}

const { facts } = Astro.props;
---

<dl class="border-b border-line">
  {
    facts.map((fact) => (
      <div class="grid gap-2 border-t border-line py-8 sm:grid-cols-[7fr_5fr] sm:gap-6">
        <dt class="text-lead font-medium text-ink">{fact.term}</dt>
        <dd>{fact.def}</dd>
      </div>
    ))
  }
</dl>
