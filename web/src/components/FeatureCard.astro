---
import type { AstroComponent } from "@lucide/astro";
import Scrim from "./Scrim.astro";

interface Props {
  icon: AstroComponent;
  eyebrow: string;
  title: string;
  desc: string;
}

const { icon: Icon, eyebrow, title, desc } = Astro.props;
---

<article
  class="relative isolate row-span-4 grid min-w-0 grid-cols-1 grid-rows-subgrid gap-0 overflow-hidden rounded-panel bg-surface p-6 sm:p-8"
>
  <div class="absolute inset-0 -z-20"><slot /></div>
  <Scrim />
  <div class="min-h-64 sm:min-h-72"></div>
  <p class="flex items-center gap-2 text-small font-medium">
    <Icon class="size-4" stroke-width={1.75} aria-hidden="true" />
    {eyebrow}
  </p>
  <h3 class="mt-3 text-title text-ink">{title}</h3>
  <p class="mt-2">{desc}</p>
</article>
