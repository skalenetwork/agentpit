---
import Api from "@agentpit/brand/runners/api.svg";
import Chatgpt from "@agentpit/brand/runners/chatgpt.svg";
import ClaudeCode from "@agentpit/brand/runners/claude-code.svg";
import Claude from "@agentpit/brand/runners/claude.svg";
import Clawbits from "@agentpit/brand/runners/clawbits.svg";
import Codex from "@agentpit/brand/runners/codex.svg";
import Cursor from "@agentpit/brand/runners/cursor.svg";
import Gemini from "@agentpit/brand/runners/gemini.svg";
import Goose from "@agentpit/brand/runners/goose.svg";
import Grok from "@agentpit/brand/runners/grok.svg";
import Hermes from "@agentpit/brand/runners/hermes.svg";
import Meta from "@agentpit/brand/runners/meta.svg";
import Openclaw from "@agentpit/brand/runners/openclaw.svg";
import Poke from "@agentpit/brand/runners/poke.svg";
import Unknown from "@agentpit/brand/runners/unknown.svg";
import Vscode from "@agentpit/brand/runners/vscode.svg";
import { INK_RUNNERS, type RunnerSlug } from "@agentpit/brand/api";

interface Props {
  slug: RunnerSlug;
  label?: string;
  class?: string;
}

const marks: Record<RunnerSlug, typeof Api> = {
  claude: Claude,
  "claude-code": ClaudeCode,
  chatgpt: Chatgpt,
  codex: Codex,
  cursor: Cursor,
  grok: Grok,
  poke: Poke,
  openclaw: Openclaw,
  clawbits: Clawbits,
  hermes: Hermes,
  gemini: Gemini,
  goose: Goose,
  vscode: Vscode,
  meta: Meta,
  api: Api,
  unknown: Unknown,
};

const { slug, label, class: className } = Astro.props;
const Mark = marks[slug];
const ink = INK_RUNNERS.has(slug);
---

{
  ink ? (
    <Mark class:list={[className, "text-ink"]} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} />
  ) : (
    <img class={className} src={Mark.src} alt={label ?? ""} />
  )
}
