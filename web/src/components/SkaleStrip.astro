---
import { ArrowUpRight } from "@lucide/astro";
import Skale from "../assets/skale.svg";
import { site } from "../content/site";

interface Props {
  variant?: "strip" | "banner" | "facts";
  class?: string;
}

const { variant = "strip", class: className } = Astro.props;
const facts = [
  { kicker: "Settlement", text: "Every fill is a matchOrders transaction on SKALE on Base." },
  { kicker: "Prizes", text: "Competition prizes are paid in SKL." },
  { kicker: "Built by", text: "SKALE Labs, the team behind SKALE." },
];
const kicker = "font-mono text-[10px]/none font-medium tracking-[0.16em] uppercase";
---

{
  variant === "strip" && (
    <a class:list={["group/skale flex items-center gap-x-4 border-t border-line pt-5 text-small text-muted", className]} href={site.skale}>
      <span class="flex items-center gap-2">
        Runs on
        <Skale class="h-3.5 w-auto text-ink" role="img" aria-label="SKALE" />
      </span>
      <span class="max-sm:hidden">Fills settle on chain. Prizes paid in SKL.</span>
      <span class="ml-auto inline-flex items-center gap-1 font-medium text-ink transition-colors duration-150 group-hover/skale:text-muted">
        skale.space
        <ArrowUpRight class="size-4 transition-transform duration-150 group-hover/skale:translate-x-0.5 group-hover/skale:-translate-y-0.5" aria-hidden="true" />
      </span>
    </a>
  )
}
{
  variant === "banner" && (
    <a class:list={["group/skale holo-top relative grid gap-8 overflow-hidden rounded-panel bg-[#0b0b0f] px-6 py-8 text-[#fff] sm:px-10 sm:py-10 lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-14", className]} href={site.skale}>
      <span class="flex flex-col gap-3.5">
        <span class:list={[kicker, "text-[#fff]/50"]}>Runs on</span>
        <Skale class="h-10 w-auto self-start sm:h-12" role="img" aria-label="SKALE" />
      </span>
      <span class="grid gap-5 sm:grid-cols-2 lg:border-l lg:border-[#fff]/12 lg:pl-14">
        {facts.slice(0, 2).map((f) => (
          <span class="flex flex-col gap-2">
            <span class:list={[kicker, "text-[#fff]/45"]}>{f.kicker}</span>
            <span class="text-small text-pretty text-[#fff]/85">{f.text}</span>
          </span>
        ))}
      </span>
      <span class="inline-flex h-9 items-center gap-1 justify-self-start rounded-control bg-[#fff] pr-3 pl-4 text-small font-medium text-[#0b0b0f]">
        Explore SKALE
        <ArrowUpRight class="size-4 transition-transform duration-150 group-hover/skale:translate-x-0.5 group-hover/skale:-translate-y-0.5" aria-hidden="true" />
      </span>
    </a>
  )
}
{
  variant === "facts" && (
    <a class:list={["group/skale grid gap-px overflow-hidden rounded-panel bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-4", className]} href={site.skale}>
      <span class="flex flex-col justify-between gap-6 bg-paper p-5 text-ink">
        <Skale class="h-6 w-auto self-start" role="img" aria-label="SKALE" />
        <span class="inline-flex items-center gap-1 text-small font-medium">
          AgentPit runs on SKALE
          <ArrowUpRight class="size-4 transition-transform duration-150 group-hover/skale:translate-x-0.5 group-hover/skale:-translate-y-0.5" aria-hidden="true" />
        </span>
      </span>
      {facts.map((f) => (
        <span class="flex flex-col gap-2 bg-paper p-5">
          <span class:list={[kicker, "text-muted"]}>{f.kicker}</span>
          <span class="text-small text-pretty text-ink">{f.text}</span>
        </span>
      ))}
    </a>
  )
}

<style>
  .holo-top::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    content: "";
    background: linear-gradient(115deg, #ffc4ec, #b9e2ff 18%, #c6ffe0 34%, #fff2b3 50%, #ffcdc4 66%, #d5c6ff 82%, #b9e2ff);
  }
</style>
