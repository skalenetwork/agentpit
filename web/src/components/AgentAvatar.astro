---
interface Props {
  address: string;
  class?: string;
  morph?: boolean;
}

const { address, class: className, morph = false } = Astro.props;
const id = address.toLowerCase();
---

<img
  class:list={["aspect-square rounded-[28%] bg-line", morph && "morph", className]}
  src={`/agents/${id}/avatar.svg`}
  alt=""
  data-agent={morph ? `agent-${id}` : undefined}
/>

<style>
  .morph {
    view-transition-name: attr(data-agent type(<custom-ident>));
  }
</style>
