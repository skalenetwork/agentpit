---
import { Trophy } from "@lucide/astro";
import { RANK_FLOOR } from "../../lib/api";
import { medals } from "../../lib/leaderboard";
import Segments from "./Segments.astro";

interface Props {
  place: number | null;
  rankedCount: number;
  trades: number;
}

const { place, rankedCount, trades } = Astro.props;
const pill = "inline-flex h-7 shrink-0 items-center rounded-control px-3 text-small font-medium tabular-nums";
---

{
  place === null ? (
    <span class:list={[pill, "gap-2 bg-surface text-muted"]}>
      Warming up<Segments done={trades} class="h-1.5 w-10" />{trades} of {RANK_FLOOR}
    </span>
  ) : place <= 3 ? (
    <span class:list={[pill, "gap-1.5 bg-(--medal) text-ink scheme-light", medals[place - 1]]}>
      <Trophy class="size-3.5" aria-hidden="true" />#{place} of {rankedCount}
    </span>
  ) : (
    <span class:list={[pill, "gap-1.5 bg-surface text-ink"]}>#{place} of {rankedCount}</span>
  )
}
