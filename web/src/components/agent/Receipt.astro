---
import { ArrowUpRight, X } from "@lucide/astro";
import type { Burst } from "@agentpit/brand/activity";
import { explorerTx, marketCaption } from "@agentpit/brand/api";
import { cents, clock, count, exactDollars, shortAddress, signedDollars, tone } from "@agentpit/brand/format";
import Polymarket from "@agentpit/brand/polymarket.svg";
import type { Fill, Profile } from "../../lib/api";
import { hues } from "../../lib/leaderboard";
import Glyph from "./Glyph.astro";
import Outcome from "./Outcome.astro";

interface Props {
  id: string;
  burst: Burst<Fill>;
  verb: string;
  span: string;
  open: Profile["positions"]["open"];
  now: number;
}

const { id, burst, verb, span, open, now } = Astro.props;
const { title, url, fills } = burst;
const done = { TRADE: "Filled at", SPLIT: "Split at", MERGE: "Merged at", REDEEM: "Redeemed at" } as const;
const trade = burst.type === "TRADE";
const caption = marketCaption(burst, now);
const facts = [
  [done[burst.type], span],
  ["Shares", count(burst.shares)],
  ...(trade && burst.shares > 0 ? [["Average price", cents(burst.dollars / burst.shares)]] : []),
  [burst.side === "SELL" || burst.type === "MERGE" || burst.type === "REDEEM" ? "Proceeds" : "Cost", exactDollars(burst.dollars)],
];
const held = open.find((position) => position.title === title && position.outcome === burst.outcome);
const row = "flex min-h-10 items-center justify-between gap-4 border-t border-line py-2";
---

<div
  id={id}
  popover="auto"
  role="dialog"
  aria-labelledby={`${id}-title`}
  class="m-auto max-h-[88dvh] w-full overflow-y-auto rounded-t-panel bg-paper p-6 text-small text-ink shadow-overlay transition-[opacity,display,overlay] transition-discrete duration-150 backdrop:bg-scrim not-open:opacity-0 starting:open:opacity-0 max-md:mb-0 md:w-sheet md:rounded-panel"
>
  <button
    type="button"
    popovertarget={id}
    popovertargetaction="hide"
    aria-label="Close"
    class="absolute top-3.75 right-3.75 grid size-7.5 place-items-center rounded-control text-muted transition-colors duration-150 hover:bg-surface hover:text-ink"
  >
    <X class="size-3.5" stroke-width={1.75} aria-hidden="true" />
  </button>
  <header class="flex items-start gap-3 pr-6">
    <Glyph title={title} icon={burst.icon} category={burst.category} />
    <div class="min-w-0">
      <h2 id={`${id}-title`} class="text-body font-medium text-pretty">
        {
          url ? (
            <a class="group/link" href={url} target="_blank" rel="noopener">
              <span class="underline-offset-2 group-hover/link:underline">{title}</span>
              <Polymarket class="ml-0.5 inline size-3 align-baseline text-muted transition-colors duration-150 group-hover/link:text-ink" aria-hidden="true" />
              <span class="sr-only">, on Polymarket</span>
            </a>
          ) : (
            title
          )
        }
      </h2>
      {
        caption.length > 0 && (
          <p class="mt-0.5 text-caption text-muted">
            {caption.map((part, i) => (i ? <Fragment> <span class="text-faint">·</span> <span class="whitespace-nowrap">{part}</span></Fragment> : part))}
          </p>
        )
      }
    </div>
  </header>
  <p class="mt-4 flex min-h-6 items-center gap-1.5">
    <span class="font-medium">{verb}</span>
    {burst.outcome && <Outcome outcome={burst.outcome} />}
    {fills.length > 1 && <span class="text-muted tabular-nums">×{fills.length}</span>}
  </p>
  <dl class="mt-3 tabular-nums">
    {
      facts.map(([term, value]) => (
        <div class={row}>
          <dt class="shrink-0 text-muted">{term}</dt>
          <dd class="min-w-0 text-right">{value}</dd>
        </div>
      ))
    }
  </dl>
  {
    fills.length > 1 && (
      <section class="mt-4 tabular-nums">
        <h3 class="flex min-h-10 items-center text-caption text-muted">{fills.length} fills</h3>
        <ul>
          {fills.map((fill) => (
            <li class="grid min-h-10 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 border-t border-line py-2">
              <time class="text-muted" datetime={new Date(fill.at * 1000).toISOString()}>{clock(new Date(fill.at * 1000), true)}</time>
              <span class="truncate text-muted">{count(fill.shares)} {trade ? `at ${cents(fill.dollars / fill.shares)}` : "shares"}</span>
              <span class="text-right">{exactDollars(fill.dollars)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    (held || burst.tx) && (
      <dl class:list={["tabular-nums", fills.length > 1 && "mt-4"]}>
        {held && (
          <div class={row}>
            <dt class="shrink-0 text-muted">Position now</dt>
            <dd class="min-w-0 text-right">
              {count(held.shares)} <span class="text-faint">·</span> {held.avgPrice ? cents(held.avgPrice) : "Split"} <span class="text-faint">→</span> {cents(held.curPrice)} <span class="text-faint">·</span> <span class:list={["font-medium", hues[tone(held.pnl)]]}>{signedDollars(held.pnl)}</span>
            </dd>
          </div>
        )}
        {burst.tx && (
          <div class={row}>
            <dt class="shrink-0 text-muted">Settlement</dt>
            <dd class="min-w-0 text-right">
              <a
                class="inline-flex items-center gap-1 whitespace-nowrap underline decoration-faint underline-offset-[3px] transition-colors duration-150 hover:decoration-current"
                href={explorerTx(burst.tx)}
                target="_blank"
                rel="noopener"
              >
                Transaction <span class="font-mono">{shortAddress(burst.tx)}</span>
                <ArrowUpRight class="size-3.5 shrink-0 text-muted" aria-hidden="true" />
              </a>
            </dd>
          </div>
        )}
      </dl>
    )
  }
  {burst.tx && <p class="mt-1 text-caption text-pretty text-muted">The explorer names the house operator as sender, shows shares in raw units and does not name the market.</p>}
</div>
