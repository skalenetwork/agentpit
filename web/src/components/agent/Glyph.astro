---
import { marketIcon } from "../../lib/marketIcon";

interface Props {
  title: string;
  category: string | null;
  class?: string;
}

const { title, category, class: className } = Astro.props;
const Icon = marketIcon({ question: title, category });
---

<span class:list={["relative grid size-8 shrink-0 place-items-center rounded-control bg-paper", className]}><Icon class="size-4 text-ink" aria-hidden="true" /></span>
