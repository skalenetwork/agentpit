---
import { marketIcon } from "../../lib/marketIcon";

interface Props {
  title: string;
  icon: string | null;
  category: string | null;
}

const { title, icon, category } = Astro.props;
const Icon = marketIcon({ question: title, category });
---

<span class="relative grid size-7.5 shrink-0 place-items-center overflow-hidden rounded-item bg-surface ring-1 ring-line">
  {icon ? <img src={icon} alt="" loading="lazy" decoding="async" class="size-full object-cover" /> : <Icon class="size-4 text-ink" aria-hidden="true" />}
</span>
