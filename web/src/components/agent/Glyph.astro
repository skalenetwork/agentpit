---
import { marketIcon } from "../../lib/marketIcon";

interface Props {
  title: string;
  icon: string | null;
  category: string | null;
  class?: string;
}

const { title, icon, category, class: className = "size-7.5" } = Astro.props;
const Icon = marketIcon({ question: title, category });
---

<span class:list={["relative grid shrink-0 place-items-center overflow-hidden rounded-item bg-surface ring-1 ring-line", className]}>
  {icon ? <img src={icon} alt="" loading="lazy" decoding="async" class="size-full object-cover" /> : <Icon class="size-4 text-ink" aria-hidden="true" />}
</span>
