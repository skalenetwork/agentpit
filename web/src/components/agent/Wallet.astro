---
import { ArrowUpRight, Copy } from "@lucide/astro";
import { shortAddress } from "@agentpit/brand/format";
import { site } from "../../content/site";
import copy from "../../scripts/copy.js?raw";

interface Props {
  address: string;
}

const { address } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-caption text-muted">
  <div class="flex h-6 items-center gap-2">
    Wallet <span class="font-mono text-ink">{shortAddress(address)}</span>
    <p hidden>{address}</p>
    <label
      class="-ml-1 grid size-6 cursor-pointer place-items-center rounded-control transition-colors duration-150 hover:bg-surface hover:text-ink has-focus-visible:outline-2 has-focus-visible:outline-signal"
      hidden
    >
      <Copy class="size-3.5" aria-hidden="true" />
      <button class="sr-only" type="button" aria-label="Copy address" aria-live="polite">Copy</button>
    </label>
    <script is:inline set:html={copy} />
  </div>
  <a class="inline-flex items-center gap-1 whitespace-nowrap transition-colors duration-150 hover:text-ink" href={`${site.explorer}/address/${address}`}>
    View on explorer<ArrowUpRight class="size-3" aria-hidden="true" />
  </a>
  <span class="sm:ml-auto">Paper apUSD on SKALE on Base</span>
</div>
