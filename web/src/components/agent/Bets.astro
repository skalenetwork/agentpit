---
import type { BetStatus } from "@agentpit/brand/api";
import { betTabs, moneyTone, SHOWN, visible } from "@agentpit/brand/bets";
import { count, signedDollars } from "@agentpit/brand/format";
import type { Profile } from "../../lib/api";
import { hues } from "../../lib/leaderboard";
import BetRow from "./BetRow.astro";
import ShowAll from "./ShowAll.astro";

interface Props {
  profile: Profile;
  now: number;
}

const PANEL: Record<BetStatus, string> = {
  open: "group-has-[#bets-open:checked]/bets:block",
  won: "group-has-[#bets-won:checked]/bets:block",
  lost: "group-has-[#bets-lost:checked]/bets:block",
  sold: "group-has-[#bets-sold:checked]/bets:block",
  split: "group-has-[#bets-split:checked]/bets:block",
};

const { profile, now } = Astro.props;
const view = betTabs(profile);
---

{
  view && (
    <section class="group/bets relative min-w-0 overflow-hidden rounded-card bg-surface/70 px-5 pb-5 sm:px-6 sm:pb-6" aria-label="Bets">
      <div class="-mx-5 overflow-x-auto px-5 text-small shadow-[inset_0_-1px_0_var(--color-line)] [scrollbar-width:none] sm:-mx-6 sm:px-6" role="radiogroup" aria-label="Bets by status">
        <div class="flex gap-8 max-sm:grid max-sm:auto-cols-[minmax(max-content,1fr)] max-sm:grid-flow-col max-sm:justify-items-start max-sm:gap-3">
          {view.tabs.map(({ status, label, n, shown }) => (
            <label class="group/tab relative flex cursor-pointer items-center gap-2 pt-6 pb-4 whitespace-nowrap after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:rounded-full after:bg-ink after:opacity-0 has-checked:after:opacity-100 max-sm:flex-col max-sm:items-start max-sm:gap-0 max-sm:pt-5">
              <input class="sr-only" type="radio" name="bets" id={`bets-${status}`} checked={status === view.active} />
              <span class="rounded-item group-has-focus-visible/tab:outline-2 group-has-focus-visible/tab:outline-offset-2 group-has-focus-visible/tab:outline-signal">
                <span class="font-medium text-muted transition-colors duration-150 group-hover/tab:text-ink group-has-checked/tab:text-ink">{label}</span>{" "}
                <span class="text-muted tabular-nums">{count(n)}</span>
              </span>
              <span class:list={["tabular-nums", hues[moneyTone(shown)]]}>{signedDollars(shown)}</span>
            </label>
          ))}
        </div>
      </div>
      {view.tabs.map(({ status, bets }) => {
        const cut = visible(bets.length, SHOWN);
        return (
          <div class:list={["group/more hidden", PANEL[status]]}>
            <ul class={cut < bets.length ? "-mb-3 group-has-checked/more:-mb-5 sm:group-has-checked/more:-mb-6" : "-mb-5 sm:-mb-6"}>
              {bets.map((bet, i) => (
                <BetRow bet={bet} now={now} hidden={i >= cut} />
              ))}
            </ul>
            {cut < bets.length && <ShowAll class="mt-4 bg-paper">Show all {count(bets.length)}</ShowAll>}
          </div>
        );
      })}
    </section>
  )
}
