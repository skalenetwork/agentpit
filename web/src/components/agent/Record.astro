---
import { CircleDot } from "@lucide/astro";
import type { Profile } from "../../lib/api";
import { cents, signedDollars } from "../../lib/format";
import { hues, tone } from "../../lib/leaderboard";
import Card from "../Card.astro";
import Glyph from "./Glyph.astro";
import Outcome from "./Outcome.astro";

interface Props {
  record: NonNullable<Profile["record"]>;
}

const { wins, losses, pnls, best, worst } = Astro.props.record;
const decided = wins + losses;
const up = Math.max(0, ...pnls);
const scale = 100 / (up + Math.max(0, ...pnls.map((pnl) => -pnl)));
const zero = up * scale;
const slot = 100 / Math.max(pnls.length, 16);
const pc = (value: number) => `${+value.toFixed(2)}%`;
const bars = pnls.map((pnl, i) => {
  const height = Math.max(6, Math.abs(pnl) * scale);
  return { x: pc(i * slot + slot * 0.15), y: pc(pnl > 0 ? zero - height : zero), height: pc(height), fill: pnl > 0 ? "fill-up" : "fill-down" };
});
const won = pnls.filter((pnl) => pnl > 0).length;
const labels = best.pnl < 0 ? ["Smallest loss", "Biggest loss"] : worst.pnl > 0 ? ["Biggest win", "Smallest win"] : ["Best call", "Worst call"];
const calls = decided === 1 ? [{ label: "Only call", call: best }] : [{ label: labels[0], call: best }, { label: labels[1], call: worst }];
---

<Card icon={CircleDot} title="Record" figure={`${wins}`} context={`of ${decided} won`}>
  {
    decided >= 3 && (
      <svg class="mt-5 h-16 w-full overflow-visible" role="img" aria-label={`${won} won, ${pnls.length - won} lost, oldest to newest, bar height is P&L`}>
        <rect y={pc(zero)} width="100%" height="1" class="fill-line" />
        {bars.map((bar) => <rect x={bar.x} y={bar.y} width={pc(slot * 0.7)} height={bar.height} rx="2" class={bar.fill} />)}
      </svg>
    )
  }
  <div class="mt-auto pt-6">
    {
      calls.map(({ label, call }) => (
        <div class="border-t border-line py-4 first:border-t-0 first:pt-0 last:pb-0">
          <p class="flex items-baseline justify-between gap-3 text-caption">
            {label}
            <span class:list={["text-small font-medium tabular-nums", hues[tone(call.pnl)]]}>{signedDollars(call.pnl)}</span>
          </p>
          <div class="mt-2 flex items-start gap-3">
            <Glyph title={call.title} category={call.category} />
            <div class="min-w-0 flex-1">
              <p class="line-clamp-2 text-small text-ink">{call.title}</p>
              <p class="mt-1 flex items-center gap-2 text-caption tabular-nums">
                <Outcome outcome={call.outcome} />
                {cents(call.entry)} → {cents(call.exit)}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Card>
