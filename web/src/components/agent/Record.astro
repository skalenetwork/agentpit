---
import { recordBars } from "@agentpit/brand/chart";
import { cents, signedDollars, tone } from "@agentpit/brand/format";
import { recordCalls } from "@agentpit/brand/standing";
import type { Profile } from "../../lib/api";
import { hues } from "../../lib/leaderboard";
import MarketLink from "../MarketLink.astro";
import Glyph from "./Glyph.astro";
import Outcome from "./Outcome.astro";

interface Props {
  record: NonNullable<Profile["record"]>;
  class: string;
}

const { record, class: className } = Astro.props;
const { wins, losses, pnls } = record;
const { zero, width, bars } = recordBars(pnls);
const last = bars.at(-1);
const won = bars.filter((bar) => bar.tone === "up").length;
---

<div class:list={["pt-4", className]}>
  <p class="font-medium text-ink tabular-nums">{wins} of {wins + losses} won</p>
  {
    wins + losses >= 3 && last && (
      <Fragment>
        <svg class="mt-3 block h-22 w-full overflow-visible" role="img" aria-label={`${won} won, ${bars.length - won} lost, oldest to newest, bar height is the amount won or lost`}>
          <line x1="0" x2="100%" y1={`${zero}%`} y2={`${zero}%`} class="stroke-line" stroke-dasharray="3 3" />
          {bars.map((bar) => <rect x={`${bar.x}%`} y={`${bar.y}%`} width={`${width}%`} height={`${bar.height}%`} rx="2" class={bar.tone === "up" ? "fill-up" : "fill-down"} />)}
        </svg>
        <svg class="mt-2 block h-4 w-full overflow-visible fill-current text-caption" aria-hidden="true">
          <text y="12">Oldest</text>
          <text x={`${last.x + width}%`} y="12" text-anchor="end">Latest</text>
        </svg>
      </Fragment>
    )
  }
  <ul class="mt-3">
    {
      recordCalls(record).map(({ label, call }) => (
        <li class="grid grid-cols-[30px_minmax(0,1fr)_auto] items-start gap-x-3 border-t border-line py-2.5 tabular-nums md:min-h-13 md:grid-cols-[30px_minmax(0,1fr)_160px_104px_104px] md:items-center md:py-2">
          <Glyph title={call.title} icon={call.icon} category={call.category} />
          <div class="min-w-0 md:contents">
            <p class="flex min-w-0"><MarketLink title={call.title} url={call.url} /></p>
            <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-muted max-md:text-caption md:contents">
              <span class="flex min-w-0 items-center gap-1.5 whitespace-nowrap">
                <span class="text-ink">{label}</span>
                <Outcome outcome={call.outcome} />
              </span>
              <span class="whitespace-nowrap md:text-right">
                {call.entry ? cents(call.entry) : "Split"} <span class="text-faint">→</span> {cents(call.exit)}
              </span>
            </p>
          </div>
          <span class:list={["text-right font-medium", hues[tone(call.pnl)]]}>{signedDollars(call.pnl)}</span>
        </li>
      ))
    }
  </ul>
</div>
