---
import { cents, dollars, signedDollars, tone } from "@agentpit/brand/format";
import type { Profile } from "../../lib/api";
import { hues } from "../../lib/leaderboard";
import MarketLink from "../MarketLink.astro";
import Glyph from "./Glyph.astro";
import Outcome from "./Outcome.astro";
import ShowAll from "./ShowAll.astro";

interface Props {
  positions: Profile["positions"];
  cash: number;
  class: string;
}

const SHOWN = 6;
const { positions, cash, class: className } = Astro.props;
const { mark, open } = positions;
---

<div class:list={["group/more", className]}>
  <div class="grid min-h-10 items-center gap-x-3 text-caption text-muted md:grid-cols-[30px_minmax(0,1fr)_104px_104px_104px_104px]">
    <p class="md:col-span-3">
      <span class="font-medium text-ink tabular-nums">{dollars(mark)}</span> in positions <span class="text-faint">·</span> <span class="font-medium text-ink tabular-nums">{dollars(cash)}</span> cash
    </p>
    {open.length > 0 && <span class="text-right max-md:hidden">Avg → now</span>}
    {open.length > 0 && <span class="text-right max-md:hidden">Value</span>}
    {open.length > 0 && <span class="text-right max-md:hidden">Earned</span>}
  </div>
  {
    open.length > 0 ? (
      <ul>
        {open.map((position, i) => {
          const sells = position.sellsFor < 0.9 * position.value;
          return (
            <li
              class:list={[
                "grid-cols-[30px_minmax(0,1fr)_auto] items-start gap-x-3 border-t border-line py-2.5 tabular-nums md:grid-cols-[30px_minmax(0,1fr)_104px_104px_104px_104px] md:items-center md:py-2",
                sells ? "md:min-h-15" : "md:min-h-13",
                i < SHOWN ? "grid" : "hidden group-has-checked/more:grid",
              ]}
            >
              <Glyph title={position.title} icon={position.icon} category={position.category} />
              <div class="min-w-0 md:contents">
                <p class="flex min-w-0"><MarketLink title={position.title} url={position.url} /></p>
                <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-muted max-md:text-caption md:contents">
                  <Outcome outcome={position.outcome} />
                  <span class="whitespace-nowrap md:text-right">
                    {position.avgPrice ? cents(position.avgPrice) : "Split"} <span class="text-faint">→</span> {cents(position.curPrice)}
                  </span>
                </p>
              </div>
              <span class="grid justify-items-end gap-0.5 md:contents">
                <span class="grid justify-items-end text-right text-ink">
                  {dollars(position.value)}
                  {sells && <span class="mt-0.5 text-caption whitespace-nowrap text-muted">sells for {dollars(position.sellsFor)}</span>}
                </span>
                <span class:list={["text-right font-medium max-md:text-caption", hues[tone(position.pnl)]]}>{signedDollars(position.pnl)}</span>
              </span>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="flex min-h-13 items-center border-t border-line text-muted">Nothing open.</p>
    )
  }
  {open.length > SHOWN && <ShowAll>Show all {open.length} positions</ShowAll>}
</div>
