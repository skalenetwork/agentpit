---
import { ArrowDown, ArrowUp, TrendingUp } from "@lucide/astro";
import { TREND_DAYS, type Profile } from "../../lib/api";
import { shortDay, signedDollars, utcTime } from "../../lib/format";
import { dollars as compact, hues, pct, tone, type Tone } from "../../lib/leaderboard";
import Card from "../Card.astro";

interface Props {
  money: Profile["money"];
  valuedAt: number;
}

const { money, valuedAt } = Astro.props;
const { returnPct, earned, trend, trendStart } = money;
const n = trend.length;
const fills: Record<Tone, string> = { up: "fill-up", down: "fill-down", flat: "fill-muted" };
const halos: Record<Tone, string> = { up: "fill-up/15", down: "fill-down/15", flat: "fill-muted/15" };
const Arrow = { up: ArrowUp, down: ArrowDown, flat: undefined }[tone(returnPct)];
const tall = n < 2 ? "min-h-24 sm:min-h-45" : "min-h-36 sm:min-h-45";
const pc = (share: number) => `${+(share * 100).toFixed(2)}%`;
const axis = (value: number) => compact(value).replace("-", "−").toLowerCase();

const top = Math.max(0, ...trend);
const bottom = Math.min(0, ...trend);
const f = (value: number) => 0.08 + (0.84 * (top - value)) / (top - bottom || 1);
const end = trend.at(-1) ?? earned;
const mood = tone(end);
const base = n < 2 ? 0.72 : f(0);
const dot = n < 2 ? 0.72 : f(end);
const zero = f(0) * 1000;
const points = trend.map((value, i) => `${((i / (n - 1)) * 1000).toFixed(1)},${(f(value) * 1000).toFixed(1)}`).join("L");
const clear = (y: number) => Math.abs(y - dot) >= 0.1;
const ticks = n < 2 ? [] : [[0.08, top], [0.92, bottom]].filter(([y, value]) => value !== 0 && Math.abs(y - base) > 0.1 && clear(y));
const stroke = { fill: "none", "stroke-width": 2, "stroke-linejoin": "round", "stroke-linecap": "round", "vector-effect": "non-scaling-stroke" } as const;
---

<Card icon={TrendingUp} title="Return" note={`As of ${utcTime(new Date(valuedAt * 1000))}`}>
  <p class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span class="text-heading whitespace-nowrap text-ink tabular-nums">
      {Arrow && <Arrow class:list={["mr-1 inline size-7 stroke-[2.5] align-[-0.12em] sm:size-8", hues[tone(returnPct)]]} aria-hidden="true" />}{pct(returnPct)}
    </span>
    <span class="text-small"><span class:list={["text-title tabular-nums", hues[tone(earned)]]}>{signedDollars(earned)}</span><span class="ml-1.5">P&L</span></span>
  </p>
  <div
    class="grid flex-1 grid-cols-[minmax(0,1fr)_auto] grid-rows-[minmax(0,1fr)_auto] gap-x-4 pt-6"
    role="img"
    aria-label={`P&L at each UTC close: ${n} ${n === 1 ? "close" : "closes"}, today ${signedDollars(end)}`}
  >
    <div class="grid *:[grid-area:1/1]">
      <svg class:list={["h-full w-full overflow-visible", tall]} aria-hidden="true">
        {ticks.map(([y]) => <line x1="0" x2="100%" y1={pc(y)} y2={pc(y)} class="stroke-line" />)}
        <line x1="0" x2="100%" y1={pc(base)} y2={pc(base)} class="stroke-muted/60" stroke-dasharray="3 4" />
        {
          n >= 2 && (
            <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" width="100%" height="100%" overflow="visible">
              <clipPath id="return-up">
                <rect y="-100" width="1000" height={zero + 100} />
              </clipPath>
              <clipPath id="return-down">
                <rect y={zero} width="1000" height={1100 - zero} />
              </clipPath>
              <g class="draw">
                <path d={`M0,${zero}L${points}L1000,${zero}Z`} class="fill-up/8" clip-path="url(#return-up)" />
                <path d={`M0,${zero}L${points}L1000,${zero}Z`} class="fill-down/8" clip-path="url(#return-down)" />
                <path d={`M${points}`} class="stroke-up" {...stroke} clip-path="url(#return-up)" />
                <path d={`M${points}`} class="stroke-down" {...stroke} clip-path="url(#return-down)" />
              </g>
            </svg>
          )
        }
        <g class="pop">
          <circle cx="100%" cy={pc(dot)} r="9" class={halos[mood]} />
          <circle cx="100%" cy={pc(dot)} r="4.5" class:list={[fills[mood], "stroke-surface"]} stroke-width="2.5" />
        </g>
      </svg>
      {n < 2 && <p class="self-center pb-10 text-center text-small text-balance">The line starts after the first UTC close.</p>}
    </div>
    <svg class:list={["h-full w-11 overflow-visible", tall]} aria-hidden="true">
      {ticks.map(([y, value]) => <text x="0" y={pc(y)} dominant-baseline="middle" class="fill-muted text-caption">{axis(value)}</text>)}
      {(n < 2 || clear(base)) && <text x="0" y={pc(base)} dominant-baseline="middle" class="fill-muted text-caption">$0</text>}
      {
        n >= 2 && (
          <text x="0" y={pc(dot)} dominant-baseline="middle" class:list={[fills[mood], "text-caption font-medium"]}>
            {`${end > 0 ? "+" : ""}${axis(end)}`}
          </text>
        )
      }
    </svg>
    <p class="mt-2 flex justify-between text-caption">
      <span>{n < 2 || !trendStart ? "" : n >= TREND_DAYS ? "30 days ago" : shortDay(new Date(trendStart))}</span><span>Today</span>
    </p>
  </div>
</Card>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .draw {
      animation: draw 1100ms cubic-bezier(0.2, 0, 0, 1) both;
    }
    .pop {
      animation: pop 300ms ease-out 900ms both;
    }
  }

  @keyframes draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
    }
  }
</style>
