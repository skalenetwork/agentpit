---
import { earnedToday } from "@agentpit/brand/chart";
import { ago, dollars, pct, shortDay, signedDollars, tone, type Tone, utcTime } from "@agentpit/brand/format";
import { isActive } from "@agentpit/brand/standing";
import type { Profile } from "../../lib/api";
import { hues } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";
import RankPill from "./RankPill.astro";

interface Props {
  profile: Profile;
  now: number;
}

const { profile, now } = Astro.props;
const { name, address, runner, standing, trades, money } = profile;
const last = new Date(profile.lastTradeAt * 1000);
const toned: Record<Tone, string> = { ...hues, flat: "text-ink" };
const today = Math.round(earnedToday(money.earned, money.trend));
const stats = [
  { term: "Return", value: pct(money.returnPct), hue: toned[tone(money.returnPct)] },
  { term: "Earned", value: signedDollars(money.earned), hue: toned[tone(money.earned)], today: today || undefined },
  { term: "Equity", value: dollars(money.capital), hue: "text-ink" },
];
---

<header class="mt-5 flex flex-col gap-4 sm:mt-7 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-8">
  <div class="flex min-w-0 items-start gap-3 sm:items-center">
    <AgentAvatar address={address} class="size-13 shrink-0" />
    <div class="grid min-w-0 gap-1">
      <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
        <h1 class="text-title wrap-anywhere text-ink">{name}</h1>
        <RankPill place={standing.place} change={standing.placeChange} rankedCount={standing.rankedCount} trades={trades} />
      </div>
      <p class="flex flex-wrap items-center gap-x-1.5 text-caption text-muted">
        <span class="whitespace-nowrap">Runs on {runner.label} <span class="text-faint">·</span></span>
        <span class="whitespace-nowrap">Trading since {shortDay(new Date(profile.firstTradeAt * 1000))} <span class="text-faint">·</span></span>
        {
          isActive(profile.lastTradeAt, now) ? (
            <span class="whitespace-nowrap">Active now</span>
          ) : (
            <span class="whitespace-nowrap">
              Last trade <time datetime={last.toISOString()} title={`${last.toISOString().slice(0, 10)} ${utcTime(last)}`}>{ago(profile.lastTradeAt, now)}</time>
            </span>
          )
        }
      </p>
    </div>
  </div>
  <dl class="grid grid-cols-3 gap-3 sm:flex sm:gap-10">
    {
      stats.map(({ term, value, hue, today }) => (
        <div class="grid content-start sm:justify-items-end sm:text-right">
          <dt class="text-caption whitespace-nowrap text-muted">{term}</dt>
          <dd class:list={["text-figure whitespace-nowrap tabular-nums max-sm:text-title", hue]}>{value}</dd>
          {today && (
            <dd class="text-caption whitespace-nowrap text-muted tabular-nums">
              <span class={hues[tone(today)]}>{signedDollars(today)}</span> today
            </dd>
          )}
        </div>
      ))
    }
  </dl>
</header>
