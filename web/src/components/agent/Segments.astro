---
import { RANK_FLOOR } from "../../lib/api";

interface Props {
  done: number;
  class: string;
}

const { done, class: className } = Astro.props;
---

<span class:list={["flex gap-px", className]} aria-hidden="true">
  {Array.from({ length: RANK_FLOOR }, (_, i) => <span class:list={["flex-1 rounded-control", i < done ? "bg-ink" : "bg-line"]} />)}
</span>
