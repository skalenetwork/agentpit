---
import { X } from "@lucide/astro";
import { explorerTx } from "@agentpit/brand/api";
import { betCaption, facts, FILLS_SHOWN, fillCounts, fillLine, moneyTone, percent, quiet, STATUS, thinLine, utc, visible } from "@agentpit/brand/bets";
import { chance, count, dollars, exactDollars, signedDollars } from "@agentpit/brand/format";
import Polymarket from "@agentpit/brand/polymarket.svg";
import type { Bet } from "../../lib/api";
import { hues } from "../../lib/leaderboard";
import Button from "../Button.astro";
import Glyph from "./Glyph.astro";
import Outcome from "./Outcome.astro";
import PriceChart from "./PriceChart.astro";
import ShowAll from "./ShowAll.astro";

interface Props {
  bet: Bet;
  now: number;
}

const CHIP: Partial<Record<Bet["status"], string>> = { won: "bg-up/10 text-up dark:bg-up/16", lost: "bg-down/10 text-down dark:bg-down/16" };

const { bet, now } = Astro.props;
const id = `bet-${bet.id}`;
const caption = betCaption(bet, now);
const thin = thinLine(bet);
const cut = visible(bet.fills.length, FILLS_SHOWN);
---

<div
  id={id}
  popover="auto"
  role="dialog"
  aria-labelledby={`${id}-title`}
  class="m-auto max-h-[calc(100dvh-32px)] w-[560px] max-w-[calc(100vw-32px)] flex-col overflow-hidden rounded-panel bg-paper text-small text-ink shadow-overlay transition-[opacity,display,overlay] transition-discrete duration-150 backdrop:bg-scrim not-open:opacity-0 open:flex starting:open:opacity-0 max-sm:mb-0 max-sm:max-h-[calc(100dvh-48px)] max-sm:w-full max-sm:max-w-none max-sm:rounded-b-none"
>
  <span class="mx-auto my-2 block h-1 w-9 shrink-0 rounded-control bg-line sm:hidden" aria-hidden="true"></span>
  <button
    type="button"
    popovertarget={id}
    popovertargetaction="hide"
    aria-label="Close"
    autofocus
    class="absolute top-2 right-2 z-1 grid size-8 place-items-center rounded-control bg-paper text-muted transition-colors duration-150 hover:bg-surface hover:text-ink"
  >
    <X class="size-4" stroke-width={1.75} aria-hidden="true" />
  </button>
  <div class="relative min-h-0 overflow-y-auto overscroll-contain p-5 max-sm:pt-0 max-sm:pb-8">
    <header class="flex items-start gap-4 pr-8">
      <Glyph title={bet.title} icon={bet.icon} category={bet.category} class="size-12 rounded-[4px]!" />
      <div class="min-w-0 flex-1">
        <h2 id={`${id}-title`} class="line-clamp-2 text-title text-pretty text-ink max-sm:line-clamp-none">{bet.title}</h2>
        {
          (caption.event || caption.text) && (
            <p class="mt-1 flex min-w-0 items-center gap-1.5 overflow-hidden text-caption whitespace-nowrap text-muted">
              {caption.event && <span class="truncate">{caption.event}</span>}
              {caption.event && caption.text && <span class="text-faint">·</span>}
              {caption.text && <span class:list={[caption.event ? "shrink-0" : "truncate", caption.live && "text-signal"]}>{caption.text}</span>}
            </p>
          )
        }
        <p class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-2 text-label text-muted tabular-nums">
          <span class:list={["inline-flex h-6 shrink-0 items-center rounded-control px-2.5 text-label font-medium whitespace-nowrap", CHIP[bet.status] ?? "bg-ink/7 text-ink"]}>{STATUS[bet.status]}</span>
          <span class="text-faint">·</span>
          <span>{dollars(bet.cost)} on</span>
          <span class="flex max-w-full min-w-0 items-center gap-1.5">
            <span class:list={["inline-flex min-w-0", bet.outcome !== "Yes" && bet.outcome !== "No" && "*:bg-ink/7 dark:*:bg-ink/10"]}><Outcome outcome={bet.outcome} /></span>
            <span class="whitespace-nowrap">at {chance(bet.entry)}</span>
          </span>
        </p>
      </div>
    </header>
    <div class="mt-6 tabular-nums">
      <p class="flex items-baseline gap-3">
        <span class:list={["text-stat", quiet(bet) ? "text-muted" : hues[moneyTone(bet.pnl)]]}>{signedDollars(bet.pnl)}</span>
        <span class="text-small font-medium text-muted" title={`On the ${dollars(bet.cost)} put in`}>{percent(bet.pnl / bet.cost)}</span>
      </p>
      {thin && <p class="mt-1 text-caption text-muted">{thin}</p>}
    </div>
    <div class="mt-6"><PriceChart bet={bet} now={now} /></div>
    <dl class="mt-6 grid text-small sm:grid-cols-2 sm:gap-x-8">
      {
        facts(bet, now).map(([term, value]) => (
          <div class="flex min-h-10 items-center justify-between gap-4 border-t border-line py-2">
            <dt class="shrink-0 text-muted">{term}</dt>
            <dd class="min-w-0 text-right text-ink tabular-nums">{value}</dd>
          </div>
        ))
      }
    </dl>
    <section class="group/more mt-8">
      <h3 class="flex h-5 items-center justify-between gap-3 text-label text-muted">
        Activity
        <span class="flex items-center gap-1.5 tabular-nums">
          {
            fillCounts(bet).map((part, i) => (
              <Fragment>
                {i > 0 && <span class="text-faint">·</span>}
                <span>{part}</span>
              </Fragment>
            ))
          }
        </span>
      </h3>
      <ul class="mt-2">
        {
          bet.fills.map((fill, i) => (
            <li class:list={["items-start justify-between gap-4 border-t border-line py-2.5", i < cut ? "flex" : "hidden group-has-checked/more:flex"]}>
              <div class="min-w-0">
                <p class="text-ink">{fillLine(fill)}</p>
                <p class="mt-0.5 text-caption text-muted tabular-nums">
                  {fill.tx ? (
                    <a
                      class="decoration-faint underline-offset-[3px] transition-colors duration-150 hover:text-ink hover:underline"
                      href={explorerTx(fill.tx)}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${utc(fill.at, now)}, settlement transaction on the explorer`}
                    >
                      {utc(fill.at, now)}
                    </a>
                  ) : (
                    utc(fill.at, now)
                  )}
                </p>
              </div>
              <p class="text-ink tabular-nums">{exactDollars(fill.dollars)}</p>
            </li>
          ))
        }
      </ul>
      {cut < bet.fills.length && <ShowAll class="mt-3 bg-surface">Show {count(bet.fills.length - cut)} more</ShowAll>}
    </section>
    {
      bet.url && (
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <Button href={bet.url} variant="secondary" size="sm" target="_blank" rel="noopener">
            <Polymarket class="size-3.5 shrink-0" aria-hidden="true" />
            Open on Polymarket
          </Button>
        </div>
      )
    }
  </div>
</div>
