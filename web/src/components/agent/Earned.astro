---
import { ChartLine } from "@lucide/astro";
import { earnedChart, moneyTone } from "@agentpit/brand/bets";
import { shortDay, type Tone } from "@agentpit/brand/format";
import type { Profile } from "../../lib/api";
import Label from "./Label.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const chart = earnedChart(profile);
const end = chart.points.at(-1);
const dots: Record<Tone, string> = { up: "fill-up stroke-up/20", down: "fill-down stroke-down/20", flat: "fill-muted stroke-muted/20" };
const stroke = { fill: "none", "stroke-width": 1.5, "stroke-linejoin": "round", "stroke-linecap": "round", "vector-effect": "non-scaling-stroke" } as const;
---

<article class="relative min-w-0 rounded-card bg-surface/70 p-5 sm:p-6">
  <Label icon={ChartLine} title="Earned" note={`Since ${shortDay(new Date(profile.firstTradeAt * 1000))}`} />
  <div class="relative mt-4 h-36 sm:h-44" role="img" aria-label={chart.label}>
    <svg class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
      <line x1="0" x2="100%" y1={`${chart.zero / 10}%`} y2={`${chart.zero / 10}%`} class="stroke-line" stroke-width="1" stroke-dasharray="3 3" />
      <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" width="100%" height="100%" overflow="visible">
        <clipPath id="earned-up">
          <rect x="-50" y="-200" width="1100" height={chart.zero + 200} />
        </clipPath>
        <clipPath id="earned-down">
          <rect x="-50" y={chart.zero} width="1100" height={1200 - chart.zero} />
        </clipPath>
        {chart.fill && <path d={chart.area} class="fill-up/6 dark:fill-up/10" clip-path="url(#earned-up)" />}
        {chart.fill && <path d={chart.area} class="fill-down/6 dark:fill-down/10" clip-path="url(#earned-down)" />}
        <path d={chart.line} class="stroke-up" {...stroke} clip-path="url(#earned-up)" />
        <path d={chart.line} class="stroke-down" {...stroke} clip-path="url(#earned-down)" />
      </svg>
      {end && <circle cx="100%" cy={`${end.y / 10}%`} r="3.5" class={dots[moneyTone(end.value)]} stroke-width="6" paint-order="stroke" />}
    </svg>
  </div>
</article>
