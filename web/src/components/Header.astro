---
import { Menu, X } from "@lucide/astro";
import Logo from "@agentpit/brand/logo.svg";
import { cta, nav, site } from "../content/site";
import Button from "./Button.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
---

<header
  class="group fixed inset-x-0 top-0 z-10 h-15 bg-paper/60 px-4 backdrop-blur-xl sm:px-12"
  data-overlay={overlay || undefined}
>
  <div class="mx-auto flex h-full w-full max-w-page items-center justify-between gap-4">
    <a class="light text-ink" href="/" aria-label={site.name}>
      <Logo class="h-4 w-auto" aria-hidden="true" />
    </a>
    <nav class="flex items-center gap-5 text-small font-medium tracking-[-0.01em]" aria-label="Site">
      {
        nav.map((link) => (
          <a
            class="light text-ink opacity-65 transition-opacity duration-150 hover:opacity-100 aria-[current=page]:opacity-100 max-sm:hidden"
            href={link.href}
            aria-current={path.startsWith(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <span class="flex w-24 justify-end max-sm:hidden"><Button class="cta" href={cta.href} size="sm">{cta.label}</Button></span>
      <button class="light grid size-8 cursor-pointer place-items-center rounded-control text-ink sm:hidden" type="button" popovertarget="menu" aria-label="Menu">
        <Menu class="size-5 group-has-open:hidden" aria-hidden="true" />
        <X class="hidden size-5 group-has-open:block" aria-hidden="true" />
      </button>
    </nav>
    <nav
      id="menu"
      class="inset-auto top-13 right-4 m-0 w-60 rounded-card bg-paper p-2.5 text-small tracking-[-0.01em] text-ink shadow-overlay transition-[opacity,display,overlay] transition-discrete duration-150 not-open:opacity-0 starting:open:opacity-0"
      popover
      aria-label="Menu"
    >
      {
        nav.map((link) => (
          <a
            class="flex h-9 items-center rounded-item px-2.5 transition-colors duration-150 hover:bg-surface"
            href={link.href}
            aria-current={path.startsWith(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    header,
    [data-overlay] .light,
    [data-overlay] :global(.cta) {
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll();
      animation-range: 0 60px;
    }

    header {
      animation-name: condense;
    }

    [data-overlay] .light {
      animation-name: light;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (prefers-color-scheme: light) {
    [data-overlay] :global(.cta) {
      animation-name: invert;
    }
  }

  @keyframes condense {
    from {
      background-color: transparent;
      backdrop-filter: none;
    }
  }

  @keyframes light {
    from {
      filter: brightness(0) invert(1);
      opacity: 1;
    }
  }

  @keyframes invert {
    from {
      filter: invert(1) grayscale(1);
    }
  }
</style>
