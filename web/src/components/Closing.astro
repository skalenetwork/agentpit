---
import sombra from "../assets/sombra.avif";
import { sentence } from "../content/start";
import Prompt from "./Prompt.astro";

interface Props {
  heading: string;
  lead: string;
  id?: string;
}

const { heading, lead, id } = Astro.props;
---

<section id={id} class="scroll-mt-16 px-5 pb-16 sm:px-12 sm:pb-25">
  <div
    class="relative isolate mx-auto flex max-w-page flex-col items-center overflow-hidden rounded-panel bg-surface px-5 py-16 text-center sm:px-8 sm:py-20"
  >
    <img
      class="absolute inset-x-0 bottom-0 -z-10 h-28 w-full object-cover sm:h-36"
      src={sombra.src}
      width={986}
      height={144}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <h2 class="text-display text-balance text-ink [text-box:trim-start_cap_alphabetic]">{heading}</h2>
    <p class="mt-3 max-w-text text-lead text-balance">{lead}</p>
    <Prompt class="mt-8" text={sentence} />
  </div>
</section>
