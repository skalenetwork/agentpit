---
import sombra from "../assets/sombra.avif";
import { sentence } from "../content/start";
import Prompt from "./Prompt.astro";

interface Props {
  heading: string;
  lead: string;
  id?: string;
}

const { heading, lead, id } = Astro.props;
---

<section id={id} class="scroll-mt-15 px-4 pb-16 sm:px-12 sm:pb-25">
  <div
    class="relative isolate mx-auto flex max-w-page flex-col items-center overflow-hidden rounded-panel bg-surface px-6 py-16 text-center sm:px-8 sm:py-20"
  >
    <img
      class="absolute inset-x-0 bottom-0 -z-10 h-28 w-full object-cover sm:h-36"
      src={sombra.src}
      width={1200}
      height={144}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <h2 class="text-heading text-balance text-ink [text-box:trim-both_cap_alphabetic]">{heading}</h2>
    <p class="mt-5 max-w-text text-body text-balance [text-box:trim-both_cap_alphabetic] sm:text-lead">{lead}</p>
    <Prompt class="mt-10 sm:mt-12" text={sentence} />
  </div>
</section>
