---
import type { AstroComponent } from "@lucide/astro";
import type { Tone } from "@agentpit/brand/format";
import { hues } from "../lib/leaderboard";

type Props = {
  title: string;
  icon: AstroComponent;
  note?: string;
  class?: string;
} & ({ figure?: never; unit?: never; tone?: never } | { figure: string; unit?: string; tone?: Tone });

const { title, icon: Icon, note, figure, unit, tone, class: className } = Astro.props;
---

<article class:list={["group/card min-w-0 rounded-card bg-surface/70 p-5 sm:p-6", className]}>
  <div class="flex h-5 items-center gap-1.5 text-label font-medium text-muted">
    <Icon class="size-3.5 shrink-0" stroke-width={1.75} aria-hidden="true" />
    <h2 class="truncate">{title}</h2>
    {
      (note || Astro.slots.has("note")) && (
        <span class="flex-1 truncate pl-3 text-right font-normal tabular-nums sm:group-has-[:is(:hover,:focus)>.reading]/card:invisible"><slot name="note">{note}</slot></span>
      )
    }
  </div>
  {
    figure !== undefined && (
      <p class="mt-2 flex min-w-0 items-baseline gap-1.5 group-has-[:is(:hover,:focus)>.reading]/card:invisible">
        <span class:list={["text-stat whitespace-nowrap tabular-nums", tone ? hues[tone] : "text-ink"]}>{figure}</span>
        {unit && <span class="truncate text-body/5 text-muted">{unit}</span>}
      </p>
    )
  }
  {Astro.slots.has("sub") && <p class="mt-1.5 truncate text-label text-muted tabular-nums"><slot name="sub" /></p>}
  <slot />
</article>
