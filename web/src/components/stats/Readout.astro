---
import { hues, type Tone } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";

interface Props {
  fig: string;
  ctx: string;
  tone?: Tone;
  avatar?: string;
  floating?: boolean;
}

const { fig, ctx, tone, avatar, floating = false } = Astro.props;
---

<span
  class:list={[
    "flex-col text-muted",
    floating ? "pointer-events-none absolute inset-x-5 top-12.5 bg-surface [display:var(--show,none)] sm:inset-x-7 sm:top-14.5" : "mt-2.5 flex",
  ]}
>
  <span class="flex min-w-0 items-baseline gap-2 whitespace-nowrap">
    <span class:list={["text-[24px]/7 font-medium tracking-[-0.03em] tabular-nums sm:text-[28px]/8", tone ? hues[tone] : "text-ink"]}>{fig}</span>
    <span class="flex items-center gap-1.5 text-small">
      {avatar && <AgentAvatar address={avatar} class="size-4.5" loading="lazy" />}{ctx}
    </span>
  </span>
  <span class="mt-1 truncate text-caption tabular-nums"><slot /></span>
</span>
