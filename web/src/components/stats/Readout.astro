---
import type { Tone } from "@agentpit/brand/format";
import { hues } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";

interface Props {
  fig: string;
  ctx: string;
  note: string;
  tone?: Tone;
  avatar?: string;
}

const { fig, ctx, note, tone, avatar } = Astro.props;
---

<span class="reading pointer-events-none [display:var(--show,none)]">
  <span class="absolute inset-x-5 top-12 flex items-baseline gap-1.5 sm:inset-x-6 sm:top-13">
    <span class:list={["text-stat whitespace-nowrap tabular-nums", tone ? hues[tone] : "text-ink"]}>{fig}</span>
    <span class="truncate text-body/5 text-muted">
      {avatar && <AgentAvatar address={avatar} class="mr-1.5 inline size-4.5 align-text-bottom" loading="lazy" />}{ctx}
    </span>
  </span>
  <span class="absolute top-6 right-6 max-w-1/2 truncate text-label text-muted tabular-nums max-sm:hidden">{note}</span>
</span>
