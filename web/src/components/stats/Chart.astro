---
import type { AstroComponent } from "@lucide/astro";
import type { Tone } from "../../lib/leaderboard";
import Readout from "./Readout.astro";

interface Props {
  icon: AstroComponent;
  title: string;
  fig: string;
  ctx: string;
  tone?: Tone;
  label: string;
  ticks: readonly { readonly at: number; readonly label: string }[];
}

const { icon: Icon, title, fig, ctx, tone, label, ticks } = Astro.props;
---

<article class="relative rounded-panel bg-surface p-5 sm:p-7 sm:pb-6">
  <h2 class="flex items-center gap-2 text-small"><Icon class="size-4 shrink-0 text-signal" aria-hidden="true" />{title}</h2>
  <Readout fig={fig} ctx={ctx} tone={tone}><slot name="note" /></Readout>
  <div class="isolate mt-9 grid h-34 grid-rows-1 *:[grid-area:1/1] sm:h-40" role="img" aria-label={label}>
    <div class="relative -z-10"><span class="absolute inset-x-0 bottom-0 h-px bg-muted/55"></span></div>
    <slot />
  </div>
  <svg class="mt-2.5 block h-4.5 w-full overflow-visible fill-current text-caption tabular-nums" aria-hidden="true">
    {
      ticks.map(({ at, label }) => (
        <text x={`${at}%`} y="13" text-anchor={at === 0 ? "start" : at === 100 ? "end" : "middle"}>
          {label}
        </text>
      ))
    }
  </svg>
</article>
