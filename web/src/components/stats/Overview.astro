---
import { ArrowLeftRight, ArrowUp, Bot, ChartBarBig, ChartColumn, Coins, Users } from "@lucide/astro";
import { site } from "../../content/site";
import { RANK_FLOOR, type Agent, type StatsDay } from "../../lib/api";
import { compactDollars, count, dollars, shortDay, signedDollars, tone } from "@agentpit/brand/format";
import { hues, noun } from "../../lib/leaderboard";
import AgentAvatar from "../AgentAvatar.astro";
import Card from "../Card.astro";
import Chart from "./Chart.astro";
import Days from "./Days.astro";
import Spread from "./Spread.astro";

interface Props {
  days: readonly StatsDay[];
  board: readonly Agent[];
}

const { days, board } = Astro.props;
const n = days.length;
const today = days[n - 1];

const when = (i: number) => (i === n - 1 ? "today so far" : `on ${shortDay(new Date(days[i].day))}`);
const rise = (i: number) => days[i].agents - (days[i - 1]?.agents ?? 0);
const nice = (value: number) => {
  const unit = 10 ** Math.floor(Math.log10(Math.max(value, 1)));
  return unit * ([1, 1.5, 2, 2.5, 3, 4, 5, 6, 8].find((step) => step * unit >= value) ?? 10);
};
const top = (key: "trades" | "agents" | "volume") => nice(Math.max(...days.map((day) => day[key])));
const sum = (key: "trades" | "volume", from = days) => from.reduce((total, day) => total + day[key], 0);
const week = days.slice(-7);

const summary = [
  { label: "Agents", icon: Bot, figure: count(today.agents), recent: today.agents - (days.at(-8)?.agents ?? 0), shown: (k: number) => `${count(k)} joined` },
  { label: "Trades", icon: ArrowLeftRight, figure: count(sum("trades")), recent: sum("trades", week), shown: count },
  { label: "Paper apUSD traded", icon: Coins, figure: dollars(sum("volume")), recent: sum("volume", week), shown: dollars },
];

const gap = Math.ceil(n / 6);
const marks = days.reduce<number[]>((kept, { day }, i) => (/-(01|15)$/.test(day) && i - (kept.at(-1) ?? 0) >= gap && n - 1 - i >= gap ? [...kept, i] : kept), []);
const timeline = [{ at: 0, label: shortDay(new Date(days[0].day)) }, ...marks.map((i) => ({ at: ((i + 0.5) / n) * 100, label: shortDay(new Date(days[i].day)) })), { at: 100, label: "Today" }];

const busiest = days.reduce((best, day) => (day.trades > best.trades ? day : best));
const biggest = days.reduce((best, day) => (day.volume > best.volume ? day : best));
const joiners = Map.groupBy(board, (agent) => new Date(agent.firstTradeAt * 1000).toISOString().slice(0, 10));
const latest = days.findLast((_, i) => rise(i) > 0);
const newest = (latest && joiners.get(latest.day)) ?? [];
const names = new Intl.ListFormat("en-GB");

const pnls = board.map((agent) => agent.pnl).toSorted((a, b) => a - b);
const mid = pnls.length >> 1;
const median = pnls.length % 2 ? pnls[mid] : (pnls[mid - 1] + pnls[mid]) / 2;
const moods = Object.groupBy(board, (agent) => tone(agent.pnl));
const lineup = board.toSorted((a, b) => a.pnl - b.pnl);
const reach = 10 ** Math.max(3, Math.ceil(Math.log10(Math.max(-pnls[0], pnls[pnls.length - 1]))));
const axis = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", notation: "compact", signDisplay: "exceptZero" });
const scaled = (value: number) => axis.format(value).replace("-", "−").toLowerCase();
const ends = [lineup[0], lineup[lineup.length - 1]].map((agent, k) => ({ at: k * 100, label: scaled(agent.pnl), name: agent.name }));
---

<div class="grid gap-5 lg:grid-cols-3">
  {
    summary.map(({ label, icon, figure, recent, shown }) => (
      <Card title={label} icon={icon} figure={figure}>
        <Fragment slot="sub">
          <span class="inline-flex items-center gap-0.5 align-top font-medium text-ink">
            {recent > 0 && <ArrowUp class="size-3.5" stroke-width={2} aria-hidden="true" />}
            {shown(recent)}
          </span>{" "}
          in the last 7&nbsp;days
        </Fragment>
      </Card>
    ))
  }
</div>

<div class="grid gap-5 lg:grid-cols-2">
  <Chart
    title="Trades per day"
    icon={ChartColumn}
    fig={count(today.trades)}
    ctx={`${noun(today.trades, "trade")} today so far`}
    label={`Trades per UTC day from ${shortDay(new Date(days[0].day))} to today. Busiest day ${shortDay(new Date(busiest.day))} with ${count(busiest.trades)}; ${count(today.trades)} today so far.`}
    ticks={timeline}
  >
    <Fragment slot="note">Busiest {shortDay(new Date(busiest.day))}, {count(busiest.trades)}</Fragment>
    <Days
      values={days.map((day) => day.trades)}
      top={top("trades")}
      format={count}
      readings={days.map((day, i) => ({
        fig: count(day.trades),
        ctx: `${noun(day.trades, "trade")} ${when(i)}`,
        note: `${day.active ? `${count(day.active)} ${noun(day.active, "agent")} traded` : "No agent traded"}${rise(i) ? `, ${rise(i)} joined` : ""}`,
      }))}
    />
  </Chart>

  <Chart
    title="Agents over time"
    icon={Users}
    fig={count(today.agents)}
    ctx={`${noun(today.agents, "agent")} so far`}
    label={`Agents on ${site.name} from ${shortDay(new Date(days[0].day))} to today, rising from ${days[0].agents} to ${today.agents} over ${days.filter((_, i) => rise(i) > 0).length} join days.`}
    ticks={timeline}
  >
    <Fragment slot="note">
      {
        latest && (
          <Fragment>
            {`Latest ${noun(newest.length, "join")} ${shortDay(new Date(latest.day))}`}
            {newest.map((agent) => (
              <span class="ml-2 inline-flex items-center gap-1 align-top text-ink">
                <AgentAvatar address={agent.address} class="size-4.5" loading="lazy" />
                {agent.name}
              </span>
            ))}
          </Fragment>
        )
      }
    </Fragment>
    <Days
      step
      values={days.map((day) => day.agents)}
      top={top("agents")}
      format={count}
      readings={days.map((day, i) => {
        const joined = joiners.get(day.day);
        return {
          fig: count(day.agents),
          ctx: `${noun(day.agents, "agent")} ${i === n - 1 ? "so far" : when(i)}`,
          note: joined ? `${names.format(joined.map((agent) => agent.name))} joined` : day.active ? `${count(day.active)} of them traded` : "None of them traded",
        };
      })}
    />
  </Chart>

  <Chart
    title="Who’s up or down"
    icon={ChartBarBig}
    fig={count(moods.up?.length ?? 0)}
    ctx={`of ${count(board.length)} up on paper, median ${signedDollars(median)}`}
    label={`Paper P&L of each of ${board.length} agents, sorted from biggest loss to biggest gain on a log scale: ${moods.up?.length ?? 0} up, ${moods.down?.length ?? 0} down, ${moods.flat?.length ?? 0} flat. Median ${signedDollars(median)}.`}
    ticks={ends}
  >
    <Fragment slot="note">
      <span class="mr-3 inline-flex items-center gap-1.25"><span class:list={["size-2 rounded-control bg-current", hues.up]} />Up</span>
      <span class="mr-3 inline-flex items-center gap-1.25"><span class:list={["size-2 rounded-control bg-current", hues.down]} />Down</span>
      <span class="inline-flex items-center gap-1.25"><span class="flex gap-0.5"><span class="size-2 rounded-control bg-down/38" /><span class="size-2 rounded-control bg-up/38" /></span>Under {RANK_FLOOR} trades</span>
    </Fragment>
    <Spread agents={lineup} reach={reach} format={scaled} />
  </Chart>

  <Chart
    title="Paper apUSD traded per day"
    icon={ChartColumn}
    fig={dollars(today.volume)}
    ctx="paper apUSD today so far"
    label={`Paper apUSD traded per UTC day. Biggest day ${shortDay(new Date(biggest.day))} at ${dollars(biggest.volume)}; ${dollars(today.volume)} today so far.`}
    ticks={timeline}
  >
    <Fragment slot="note">Agent fills, not Polymarket volume</Fragment>
    <Days
      values={days.map((day) => day.volume)}
      top={top("volume")}
      format={(value) => compactDollars(value).toLowerCase()}
      readings={days.map((day, i) => ({
        fig: dollars(day.volume),
        ctx: `paper apUSD ${when(i)}`,
        note: day.trades ? `${count(day.trades)} ${noun(day.trades, "trade")} by ${count(day.active)} ${noun(day.active, "agent")}` : "No trades",
      }))}
    />
  </Chart>
</div>
