---
import Logo from "@agentpit/brand/logo.svg";
import Skale from "../assets/skale.svg";
import { footer, legal, site } from "../content/site";
import type { Foot } from "../lib/skale";
import SkaleStrip from "./SkaleStrip.astro";
import PaidIn from "./stickers/PaidIn.astro";

interface Props {
  variant?: Foot;
}

const { variant = "strip" } = Astro.props;
const year = new Date().getFullYear();
const block = variant === "strip" || variant === "banner" || variant === "facts" ? variant : null;
const runs = { kicker: "Runs on", label: "Runs on SKALE", logo: "full", skl: false } as const;
---

<footer class="overflow-hidden px-4 pt-12 sm:px-12">
  <div class="mx-auto w-full max-w-page text-small">
    {block === "banner" && <SkaleStrip class="mb-14" variant="banner" />}
    <div class:list={["grid grid-cols-2 gap-x-8 gap-y-10", variant === "column" ? "sm:grid-cols-4 lg:grid-cols-[1.4fr_repeat(4,1fr)]" : "sm:grid-cols-4"]}>
      {
        variant === "column" && (
          <div class="col-span-full flex flex-col items-start gap-4 lg:col-span-1">
            <Logo class="h-4.5 w-auto text-ink" aria-hidden="true" />
            <p class="max-w-64 text-small text-pretty text-muted">Paper trading for prediction market bots. Every fill settles on chain.</p>
            <a class="mt-1" href={site.skale}>
              <PaidIn class="[--tilt:-3deg]" {...runs} />
            </a>
          </div>
        )
      }
      {
        footer.map((column) => (
          <nav class="flex flex-col gap-3" aria-label={column.title}>
            <h2 class="mb-1 text-caption">{column.title}</h2>
            {column.links.map((link) => (
              <a class="font-medium text-ink transition-colors duration-150 hover:text-muted" href={link.href}>
                {link.label}
              </a>
            ))}
            {variant === "sticker" && column.title === "Ecosystem" && (
              <a class="mt-3 self-start" href={site.skale}>
                <PaidIn {...runs} />
              </a>
            )}
          </nav>
        ))
      }
    </div>
    {(block === "strip" || block === "facts") && <SkaleStrip class="mt-12" variant={block} />}
    <div class:list={["flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-caption", block === "strip" ? "mt-6" : "mt-12"]}>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        © {year} {site.team}
        {legal.map((link) => <a class="font-medium text-ink transition-colors duration-150 hover:text-muted" href={link.href}>{link.label}</a>)}
      </p>
      <p>Paper money, no stakes, no affiliation with Polymarket.</p>
      <p>Person avatars: Glyphs by Matt Houser, <a class="underline underline-offset-2 transition-colors duration-150 hover:text-ink" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
      {
        variant === "line" && (
          <a class="flex w-full items-center gap-2.5 border-t border-line pt-4 text-muted transition-colors duration-150 hover:text-ink sm:w-auto sm:border-0 sm:pt-0" href={site.skale}>
            Runs on
            <Skale class="h-3 w-auto text-ink" role="img" aria-label="SKALE" />
          </a>
        )
      }
    </div>
    <Logo class="mt-20 h-auto w-full mask-b-from-45% text-ink opacity-8 max-sm:mb-6 sm:-mb-[6%]" aria-hidden="true" />
  </div>
</footer>
