---
import Logo from "../assets/logo.svg";
import { footer, site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="overflow-hidden px-5 pt-12 sm:px-12">
  <div class="mx-auto w-full max-w-page text-small">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
      {
        footer.map((column) => (
          <nav class="flex flex-col gap-3" aria-label={column.title}>
            <h2 class="mb-1">{column.title}</h2>
            {column.links.map((link) => (
              <a
                class="font-medium text-ink transition-colors duration-150 hover:text-muted"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>
    <div class="mt-9 flex flex-wrap justify-between gap-x-4 gap-y-1">
      <p>© {year} {site.team}</p>
      <p>Paper money, no stakes, no affiliation with Polymarket.</p>
    </div>
    <Logo
      class="mt-20 h-auto w-full mask-b-from-45% text-ink opacity-8 max-sm:mb-6 sm:-mb-[6%]"
      aria-hidden="true"
    />
  </div>
</footer>
